        <div id="designFilters">
          <div class="card" id="matchBar">
            <div class="section-title">
              Filters
              <span style="display:flex; gap:10px; align-items:center;">
                <a class="link" href="/glossary/stellarator" target="_blank" rel="noopener">metric glossary ↗</a>
                <button class="link" id="resetAllBtn">reset all</button>
              </span>
            </div>
            <div id="matchLabel"></div>
            <div class="track"><div class="fill" id="matchFill"></div></div>
            <div id="hint">Drag the amber handles to set a range. Click a handle's number to type one. Drag on open space to jump the nearest handle there.</div>
          </div>

          <div id="filters"></div>
        </div>
      </div>
    </div>
  </div>
  <div id="metricTooltip" class="metric-tooltip"></div>

  <script>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
    import { UMAP } from 'umap-js';
    import { requestPhysics } from '../lib/physicsClient';
    import { createPhysicsScene } from '../lib/physicsScene';
    import { heatmapPick } from '../lib/heatmap';
    import { tex, B_NORM } from '../lib/math';
    import { METRIC_INFO } from '../lib/metricInfo';
    import { drawBoozerB, drawBoozerBHover } from '../lib/modes/boozerB';
    import { drawBoozerCut, interpolatedCut, EQUAL_CUTS } from '../lib/modes/boozerCut';
    import { drawPoincare } from '../lib/modes/poincare';
    import {
      modeExplain, selectionFromHeatmap,
      refreshSelectionXyz, nearestPoincareSeedIndex,
    } from '../lib/physicsSync';

    const subtitleEl = document.getElementById('subtitle');
    const sourceEl = document.getElementById('source');
    const indexEl = document.getElementById('index');
    const globalRowEl = document.getElementById('globalRow');
    const nfpValEl = document.getElementById('nfpVal');
    const matchLabelEl = document.getElementById('matchLabel');
    const matchFillEl = document.getElementById('matchFill');
    const filtersEl = document.getElementById('filters');
    const metricTooltipEl = document.getElementById('metricTooltip');
    // Delegated (filtersEl is rebuilt per buildFilterRows call, so a
    // per-icon listener would need re-attaching every time) -- position:
    // fixed + a rect computed here escapes .metric-card's own
    // overflow:hidden, see that class's CSS comment for why a pure-CSS
    // ::after tooltip didn't work.
    filtersEl.addEventListener('mouseover', (e) => {
      const icon = e.target.closest('.info-icon');
      if (!icon) return;
      metricTooltipEl.textContent = icon.dataset.tip;
      const rect = icon.getBoundingClientRect();
      const left = Math.min(window.innerWidth - 222, Math.max(8, rect.left - 100));
      metricTooltipEl.style.left = `${left}px`;
      metricTooltipEl.style.top = `${rect.bottom + 6}px`;
      metricTooltipEl.classList.add('visible');
    });
    filtersEl.addEventListener('mouseout', (e) => {
      if (e.target.closest('.info-icon')) metricTooltipEl.classList.remove('visible');
    });
    const tsneCanvas = document.getElementById('tsneCanvas');
    const umapCanvasWrap = document.getElementById('umapCanvasWrap');
    const tsneColorByEl = document.getElementById('tsneColorBy');
    const tsneStatusEl = document.getElementById('tsneStatus');
    const tsneLegendMinEl = document.getElementById('tsneLegendMin');
    const tsneLegendMaxEl = document.getElementById('tsneLegendMax');
    const tsneLegendEl = document.getElementById('tsneLegend');
    const sourceCardsEl = document.getElementById('sourceCards');
    const leftPane = document.getElementById('leftPane');
    const rightPane = document.getElementById('rightPane');
    const leftToggle = document.getElementById('leftToggle');
    const rightToggle = document.getElementById('rightToggle');

    // Fixed, stable per-source-code color -- assigned once so a source's
    // color never shifts as filters/scope change (unlike the metric
    // gradient, which is intentionally rescaled to whatever's plotted).
    const SOURCE_COLORS = ['#5b9dff', '#ffb454', '#5bd88a', '#c76bff', '#ff6b6b', '#57d3d8'];
    let sourceCardEls = {}; // code -> { root, countEl }

    let meta, X, Y;
    let offsets = {};
    let sourceRanges = []; // [{ code, name, start, count }], sorted by start, excludes the -1 "all sources" pseudo-range
    let targetRange = []; // fixed global {min,max} per target -- never changes, used for percentiles & full reset
    let viewRange = []; // current zoom window per target -- what the histogram x-axis currently spans
    let filters = [];
    let filteredIndices = [];
    let histCanvases = [];
    let handleLabels = []; // { min: el, max: el } per target
    let currentValues = [];
    let lastCounts = [];

    let tsnePoints = null; // { globalIndices: [...], positions: [[x,y],...] }
    let hoveredSourceCode = null;

    const N_BINS = 36;

    async function loadData() {
      const [metaRes, xRes, yRes] = await Promise.all([
        fetch('/data/meta.json'),
        fetch('/data/X.bin'),
        fetch('/data/Y.bin'),
      ]);
      meta = await metaRes.json();
      X = new Float32Array(await xRes.arrayBuffer());
      Y = new Float32Array(await yRes.arrayBuffer());
      currentValues = new Array(meta.y_cols).fill(null);

      let start = 0;
      for (const code of Object.keys(meta.source_legend).map(Number).sort((a, b) => a - b)) {
        const name = meta.source_legend[code];
        const count = meta.source_counts[name];
        offsets[code] = { start, count, name };
        start += count;
      }
      offsets[-1] = { start: 0, count: meta.n, name: 'all sources' };

      sourceEl.innerHTML = '';
      const allOpt = document.createElement('option');
      allOpt.value = -1;
      allOpt.textContent = `all sources (${meta.n.toLocaleString()})`;
      sourceEl.appendChild(allOpt);
      sourceRanges = [];
      sourceCardsEl.innerHTML = '';
      sourceCardEls = {};
      for (const code of Object.keys(meta.source_legend).map(Number).sort((a, b) => a - b)) {
        const { name, count } = offsets[code];
        const opt = document.createElement('option');
        opt.value = code;
        opt.textContent = `${name} (${count.toLocaleString()})`;
        sourceEl.appendChild(opt);

        sourceRanges.push({ code, name, start: offsets[code].start, count });

        const card = document.createElement('div');
        card.className = 'source-card';
        card.style.setProperty('--src-color', SOURCE_COLORS[code % SOURCE_COLORS.length]);
        card.innerHTML = `<span class="dot"></span><span class="name">${name}</span><span class="count"></span>`;
        card.addEventListener('mouseenter', () => { hoveredSourceCode = code; card.classList.add('active'); if (tsnePoints) drawTSNE(); });
        card.addEventListener('mouseleave', () => { hoveredSourceCode = null; card.classList.remove('active'); if (tsnePoints) drawTSNE(); });
        sourceCardsEl.appendChild(card);
        sourceCardEls[code] = { root: card, countEl: card.querySelector('.count') };
      }

      for (let t = 0; t < meta.y_cols; t++) {
        let mn = Infinity, mx = -Infinity;
        for (let r = 0; r < meta.n; r++) {
          const v = Y[r * meta.y_cols + t];
          if (v < mn) mn = v;
          if (v > mx) mx = v;
        }
        targetRange.push({ min: mn, max: mx });
        viewRange.push({ min: mn, max: mx });
        filters.push({ min: mn, max: mx });
      }

      tsneColorByEl.innerHTML = '';
      const sourceOpt = document.createElement('option');
      sourceOpt.value = 'source';
      sourceOpt.textContent = 'source';
      tsneColorByEl.appendChild(sourceOpt);
      meta.target_names.forEach((name, t) => {
        const opt = document.createElement('option');
        opt.value = t;
        opt.textContent = name;
        tsneColorByEl.appendChild(opt);
      });
      tsneColorByEl.value = 'source';

      buildFilterRows();
      subtitleEl.textContent = `${meta.n.toLocaleString()} candidates loaded`;
    }

    // Ranges are contiguous per source (each export block is appended as one
    // run), so a global row index maps to exactly one source without needing
    // a separate per-row source array.
    function sourceCodeOf(gi) {
      for (const r of sourceRanges) {
        if (gi >= r.start && gi < r.start + r.count) return r.code;
      }
      return null;
    }

    function roundSig(v, sig) {
      const a = Math.abs(v);
      if (a !== 0 && (a < 1e-3 || a >= 1e5)) return v.toExponential(Math.max(0, sig - 1));
      return Number(v.toPrecision(sig)).toString();
    }
    const round5 = (v) => roundSig(v, 5);
    const fmt = (v) => (v === null || v === undefined ? '–' : roundSig(v, 3));

    function buildFilterRows() {
      filtersEl.innerHTML = '';
      histCanvases = [];
      handleLabels = [];
      meta.target_names.forEach((name, t) => {
        const row = document.createElement('div');
        row.className = 'card metric-card';

        const info = METRIC_INFO[name];
        const iconHtml = info ? `<span class="info-icon" data-tip="${info.short.replace(/"/g, '&quot;')}">i</span>` : '';

        row.innerHTML = `
          <button class="metric-header" data-t="${t}">
            <span class="chevron">▸</span>
            <span class="metric-name">${name}</span>
            ${iconHtml}
            <span class="metric-value-inline" id="cur-${t}">–</span>
            <span class="spacer"></span>
            <span class="metric-pct" id="pct-${t}"></span>
          </button>
          <div class="metric-body">
            <div class="body-toolbar">
              <button class="link" id="zoom-reset-${t}">reset zoom</button>
            </div>
            <div class="hist-wrap">
              <span class="handle-label" id="handle-min-${t}"></span>
              <span class="handle-label" id="handle-max-${t}"></span>
            </div>
          </div>`;

        const canvas = document.createElement('canvas');
        canvas.width = 336; canvas.height = 52;
        histCanvases[t] = canvas;
        row.querySelector('.hist-wrap').insertBefore(canvas, row.querySelector('.handle-label'));

        row.querySelector('.metric-header').addEventListener('click', () => row.classList.toggle('expanded'));
        row.querySelector(`#zoom-reset-${t}`).addEventListener('click', () => resetZoom(t));

        filtersEl.appendChild(row);

        const minLabel = document.getElementById(`handle-min-${t}`);
        const maxLabel = document.getElementById(`handle-max-${t}`);
        handleLabels[t] = { min: minLabel, max: maxLabel };
        makeLabelEditable(minLabel, t, 'min');
        makeLabelEditable(maxLabel, t, 'max');

        setupDrag(canvas, t);
      });
      meta.target_names.forEach((_, t) => positionHandles(t));
    }

    function positionHandles(t, liveOverride) {
      const { min, max } = viewRange[t];
      const span = (max - min) || 1;
      const f = liveOverride || filters[t];
      const minFrac = Math.min(1, Math.max(0, (f.min - min) / span));
      const maxFrac = Math.min(1, Math.max(0, (f.max - min) / span));
      const { min: minEl, max: maxEl } = handleLabels[t];
      minEl.style.left = `${minFrac * 100}%`;
      maxEl.style.left = `${maxFrac * 100}%`;
      if (!minEl.querySelector('input')) minEl.textContent = round5(f.min);
      if (!maxEl.querySelector('input')) maxEl.textContent = round5(f.max);
    }

    // Zooms the histogram's view window out to the full dataset range for
    // this target (and clears its filter back to "everything", matching --
    // a lingering narrow filter with a zoomed-out view would be confusing).
    function resetZoom(t) {
      viewRange[t] = { ...targetRange[t] };
      filters[t] = { ...targetRange[t] };
      positionHandles(t);
      recomputeFiltered();
    }

    function makeLabelEditable(labelEl, t, which) {
      labelEl.addEventListener('click', () => {
        if (labelEl.querySelector('input')) return;
        const current = filters[t][which];
        labelEl.textContent = '';
        const input = document.createElement('input');
        input.type = 'number'; input.step = 'any'; input.value = current;
        labelEl.appendChild(input);
        input.focus(); input.select();
        const commit = () => {
          const v = Number(input.value);
          if (!Number.isNaN(v)) {
            const next = { ...filters[t], [which]: v };
            setFilter(t, next.min, next.max);
          } else {
            positionHandles(t);
          }
        };
        input.addEventListener('blur', commit);
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') input.blur();
          if (e.key === 'Escape') { positionHandles(t); }
        });
      });
    }

    function setFilter(t, min, max) {
      filters[t] = { min: Math.min(min, max), max: Math.max(min, max) };
      positionHandles(t);
      recomputeFiltered();
    }

    // --- Drag directly on a histogram: grab a handle, or click open space
    // to jump the nearest handle there (then keep dragging it). ---
    function setupDrag(canvas, t) {
      let dragging = null; // 'min' | 'max'
      const HIT_PX = 10;

      function fracFromEvent(e) {
        const rect = canvas.getBoundingClientRect();
        return Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      }
      function fracToValue(frac) {
        const { min, max } = viewRange[t];
        return min + frac * (max - min);
      }
      function fracOf(which) {
        const { min, max } = viewRange[t];
        const span = (max - min) || 1;
        return (filters[t][which] - min) / span;
      }

      function onMove(e) {
        const frac = fracFromEvent(e);
        const value = fracToValue(frac);
        const live = { ...filters[t], [dragging]: value };
        if (live.min > live.max) { live[dragging] = filters[t][dragging === 'min' ? 'max' : 'min']; }
        positionHandles(t, live);
        drawHistogram(t, lastCounts[t], { liveFilter: live });
        const label = handleLabels[t][dragging];
        if (!label.querySelector('input')) label.textContent = round5(value);
      }

      function onUp(e) {
        window.removeEventListener('mousemove', onMove);
        window.removeEventListener('mouseup', onUp);
        const frac = fracFromEvent(e);
        const value = fracToValue(frac);
        const next = dragging === 'min' ? { min: value, max: filters[t].max } : { min: filters[t].min, max: value };
        filters[t] = { min: Math.min(next.min, next.max), max: Math.max(next.min, next.max) };
        // Zoom to the just-selected range -- it now fills the full width,
        // so a further drag can pick out an even finer sub-range.
        viewRange[t] = { ...filters[t] };
        positionHandles(t);
        recomputeFiltered();
        dragging = null;
      }

      canvas.addEventListener('mousedown', (e) => {
        const rect = canvas.getBoundingClientRect();
        const clickPx = e.clientX - rect.left;
        const minPx = fracOf('min') * rect.width;
        const maxPx = fracOf('max') * rect.width;
        if (Math.abs(clickPx - minPx) <= HIT_PX && Math.abs(clickPx - minPx) <= Math.abs(clickPx - maxPx)) {
          dragging = 'min';
        } else if (Math.abs(clickPx - maxPx) <= HIT_PX) {
          dragging = 'max';
        } else {
          // open space: jump the nearer handle here and keep dragging it
          dragging = Math.abs(clickPx - minPx) <= Math.abs(clickPx - maxPx) ? 'min' : 'max';
        }
        window.addEventListener('mousemove', onMove);
        window.addEventListener('mouseup', onUp);
      });
    }

    document.getElementById('resetAllBtn').addEventListener('click', () => {
      for (let t = 0; t < meta.y_cols; t++) {
        filters[t] = { ...targetRange[t] };
        viewRange[t] = { ...targetRange[t] };
        positionHandles(t);
      }
      recomputeFiltered();
    });

    function sourceScope() {
      return offsets[Number(sourceEl.value)];
    }

    function recomputeFiltered() {
      const { start, count } = sourceScope();
      const yCols = meta.y_cols;

      filteredIndices = [];
      const hist = Array.from({ length: yCols }, () => new Array(N_BINS).fill(0));

      for (let i = 0; i < count; i++) {
        const gi = start + i;
        const yBase = gi * yCols;
        let pass = true;
        for (let t = 0; t < yCols; t++) {
          const v = Y[yBase + t];
          if (v < filters[t].min || v > filters[t].max) pass = false;
          // Histogram bins reflect the current zoomed view, not the full
          // dataset range -- values currently scrolled out of view are
          // skipped rather than piled into the edge bins (which would
          // misrepresent those bins as taller than they really are).
          const { min: vmin, max: vmax } = viewRange[t];
          if (v < vmin || v > vmax) continue;
          const bin = Math.min(N_BINS - 1, Math.max(0, Math.floor(((v - vmin) / (vmax - vmin || 1)) * N_BINS)));
          hist[t][bin]++;
        }
        if (pass) filteredIndices.push(gi);
      }
      lastCounts = hist;
      for (let t = 0; t < yCols; t++) drawHistogram(t, hist[t]);

      const frac = count ? filteredIndices.length / count : 0;
      matchLabelEl.innerHTML = `<b>${filteredIndices.length.toLocaleString()}</b> of ${count.toLocaleString()} match`;
      matchFillEl.style.width = `${(frac * 100).toFixed(1)}%`;

      indexEl.max = Math.max(0, filteredIndices.length - 1);
      if (Number(indexEl.value) >= filteredIndices.length) indexEl.value = 0;
      renderCandidate();
    }

    function drawHistogram(t, counts, opts) {
      const canvas = histCanvases[t];
      const ctx = canvas.getContext('2d');
      const w = canvas.width, h = canvas.height;
      ctx.clearRect(0, 0, w, h);
      const maxCount = Math.max(1, ...counts);
      const barW = w / N_BINS;
      const { min, max } = viewRange[t];
      const f = (opts && opts.liveFilter) || filters[t];

      for (let b = 0; b < N_BINS; b++) {
        const binLo = min + (b / N_BINS) * (max - min);
        const binHi = min + ((b + 1) / N_BINS) * (max - min);
        const inRange = binHi >= f.min && binLo <= f.max;
        const barH = Math.max(1, (counts[b] / maxCount) * (h - 4));
        ctx.fillStyle = inRange ? '#5b9dff' : '#33333a';
        ctx.fillRect(b * barW, h - barH, Math.max(1, barW - 1), barH);
      }

      // handle markers (draggable range boundaries)
      ['min', 'max'].forEach((which) => {
        const span = (max - min) || 1;
        const x = ((f[which] - min) / span) * w;
        ctx.fillStyle = '#ffb454';
        ctx.fillRect(x - 1, 0, 2, h);
        ctx.beginPath();
        ctx.moveTo(x - 5, 0);
        ctx.lineTo(x + 5, 0);
        ctx.lineTo(x, 7);
        ctx.closePath();
        ctx.fill();
      });

      // marker for the current candidate's value
      const cv = currentValues[t];
      if (cv !== null && cv !== undefined && cv >= min && cv <= max) {
        const x = ((cv - min) / (max - min || 1)) * w;
        ctx.strokeStyle = 'rgba(255,255,255,0.9)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, h);
        ctx.stroke();
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(x, h - 2, 3, 0, 2 * Math.PI);
        ctx.fill();
      }
    }

    // R,Z Fourier synthesis: r_cos/z_sin are [m, n_idx] (m=0..4, n_idx=0..8,
    // real n = n_idx - 4), matching this project's fixed feature layout.
    function surfacePoints(rowStart, nfp, nTheta, nPhi) {
      const rCos = X.subarray(rowStart, rowStart + 45);
      const zSin = X.subarray(rowStart + 45, rowStart + 90);
      const positions = new Float32Array(nTheta * nPhi * 3);
      let idx = 0;
      for (let it = 0; it < nTheta; it++) {
        const theta = (it / nTheta) * 2 * Math.PI;
        for (let ip = 0; ip < nPhi; ip++) {
          const phi = (ip / nPhi) * 2 * Math.PI;
          let R = 0, Z = 0;
          for (let m = 0; m < 5; m++) {
            for (let nIdx = 0; nIdx < 9; nIdx++) {
              const n = nIdx - 4;
              const angle = m * theta - nfp * n * phi;
              R += rCos[m * 9 + nIdx] * Math.cos(angle);
              Z += zSin[m * 9 + nIdx] * Math.sin(angle);
            }
          }
          const x = R * Math.cos(phi);
          const y = R * Math.sin(phi);
          positions[idx++] = x;
          positions[idx++] = y;
          positions[idx++] = Z;
        }
      }
      return positions;
    }

    function buildGeometry(rowStart, nfp) {
      const nTheta = 64, nPhi = 128;
      const positions = surfacePoints(rowStart, nfp, nTheta, nPhi);
      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      const indices = [];
      for (let it = 0; it < nTheta; it++) {
        const itNext = (it + 1) % nTheta;
        for (let ip = 0; ip < nPhi; ip++) {
          const ipNext = (ip + 1) % nPhi;
          const a = it * nPhi + ip;
          const b = itNext * nPhi + ip;
          const c = itNext * nPhi + ipNext;
          const d = it * nPhi + ipNext;
          indices.push(a, b, c, a, c, d);
        }
      }
      geometry.setIndex(indices);
      geometry.computeVertexNormals();
      return geometry;
    }

    // --- Three.js scene setup ---
    const wrap = document.getElementById('canvas-wrap');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0c0c0e);
    const camera = new THREE.PerspectiveCamera(50, 1, 0.01, 100);
    camera.position.set(2, 1.5, 2);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    wrap.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;

    scene.add(new THREE.AmbientLight(0xffffff, 0.5));
    const dirLight = new THREE.DirectionalLight(0xffffff, 1.0);
    dirLight.position.set(3, 5, 4);
    scene.add(dirLight);
    const dirLight2 = new THREE.DirectionalLight(0xffffff, 0.4);
    dirLight2.position.set(-3, -2, -4);
    scene.add(dirLight2);

    const axes = new THREE.AxesHelper(1.5);
    scene.add(axes);

    let mesh = null;
    const material = new THREE.MeshStandardMaterial({
      color: 0x5b9dff, emissive: 0x16345c, metalness: 0.08, roughness: 0.5,
      side: THREE.DoubleSide,
    });

    // Physics modes use a second THREE scene so Design's camera/mesh stay
    // untouched. The DESC surface lives in #physics-3d; the 2D panel is
    // a canvas heatmap / R–Z plot, not a paint-over of surfacePoints().
    const physicsWrap = document.getElementById('physics-wrap');
    const physics3dEl = document.getElementById('physics-3d');
    const physicsAnalysis = document.getElementById('physics-analysis');
    const canvasBoozerB = document.getElementById('canvas-boozer-b');
    const bmapLabels = document.getElementById('bmap-labels');
    const bmapHover = document.getElementById('bmap-hover');
    // Declared up here, not next to the handlers, so anything that runs
    // during init can clear the hover without hitting the TDZ.
    let hoverPick = null;
    let hoverQueued = false;
    const canvasBoozerCut = document.getElementById('canvas-boozer-cut');
    const canvasPoincare = document.getElementById('canvas-poincare');
    const physicsCard = document.getElementById('physicsCard');
    const physicsCardTitle = document.getElementById('physicsCardTitle');
    const physicsExplain = document.getElementById('physicsExplain');
    const statusEl = document.getElementById('status');
    const physicsReadout = document.getElementById('physicsReadout');
    const eqBackendEl = document.getElementById('eqBackend');
    const sSlider = document.getElementById('sSlider');
    const sVal = document.getElementById('sVal');
    const cmapSelect = document.getElementById('cmapSelect');
    const nContoursEl = document.getElementById('nContours');
    const nContoursVal = document.getElementById('nContoursVal');
    const zetaSlider = document.getElementById('zetaSlider');
    const zetaVal = document.getElementById('zetaVal');
    zetaSlider.min = '0';
    zetaSlider.step = String(1 / EQUAL_CUTS);
    zetaSlider.max = String((EQUAL_CUTS - 1) / EQUAL_CUTS);
    const phiSlider = document.getElementById('phiSlider');
    const phiVal = document.getElementById('phiVal');
    const nSeedsEl = document.getElementById('nSeeds');
    const nTurnsEl = document.getElementById('nTurns');
    const physicsScene = createPhysicsScene(physics3dEl);

    function setMath(id, src) {
      const el = document.getElementById(id);
      if (el) el.innerHTML = tex(src);
    }
    setMath('math-cut-title', '\\zeta=\\mathrm{const}');
    setMath('math-poincare-title', '\\varphi=\\mathrm{const}');
    setMath('math-bmap-title', `${B_NORM}(\\theta,\\zeta)`);
    setMath('math-s', 's');
    setMath('math-B-range', B_NORM);
    setMath('math-B-surf', B_NORM);
    setMath('math-zeta', '\\zeta');
    setMath('math-phi', '\\varphi\\ \\mathrm{plane}');
    setMath('math-phi-pi', '\\pi');
    setMath('math-phi-2pi', '2\\pi');
    setMath('math-rz', 'R\\!-\\!Z');
    setMath('math-xz', 'X\\!-\\!Z');
    setMath('axis-poincare-y', 'Z');
    setMath('axis-poincare-x', 'R');

    let viewMode = 'design';
    let physicsBundle = null;
    let physicsAbort = null;
    let physicsSel = null;

    function currentGi() {
      if (!filteredIndices.length) return null;
      const pos = Math.max(0, Math.min(filteredIndices.length - 1, Number(indexEl.value) || 0));
      return filteredIndices[pos];
    }

    function boundaryFromGi(gi) {
      const rowStart = gi * meta.x_cols;
      const r_cos = [];
      const z_sin = [];
      for (let m = 0; m < 5; m++) {
        const r = [];
        const z = [];
        for (let n = 0; n < 9; n++) {
          r.push(X[rowStart + m * 9 + n]);
          z.push(X[rowStart + 45 + m * 9 + n]);
        }
        r_cos.push(r);
        z_sin.push(z);
      }
      return { r_cos, z_sin, nfp: X[rowStart + 90] };
    }

    function physicsRequestBody(gi) {
      const { r_cos, z_sin, nfp } = boundaryFromGi(gi);
      return {
        r_cos, z_sin, nfp: Number(nfp),
        backend: eqBackendEl.value || 'vmecpp',
        poincare: {
          n_seeds: Number(nSeedsEl.value) || 8,
          n_turns: Number(nTurnsEl.value) || 32,
          phi: Number(phiSlider.value) || 0,
          direction: 'forward',
        },
      };
    }

    // The slider is labelled and stepped in s (normalized toroidal flux), so
    // it must be matched against flux.s -- NOT flux.rho, which is sqrt(s).
    // Comparing against rho picked s=0.25 for a slider at 0.50 and s=0.49 for
    // a slider at 0.75, and put rho into meta.s, which silently killed the
    // Poincare seed match in nearestPoincareSeedIndex (it compares meta.s
    // against seed.s, which is always in s).
    function fluxIndex(bundle, s) {
      const flux = bundle && bundle.flux;
      if (!flux || !flux.s || !flux.s.length) return 0;
      let k = 0, best = Infinity;
      for (let i = 0; i < flux.s.length; i++) {
        const d = Math.abs(flux.s[i] - s);
        if (d < best) { best = d; k = i; }
      }
      return k;
    }

    function bundleAtS(bundle, s) {
      const flux = bundle && bundle.flux;
      if (!flux || !flux.s || !flux.s.length) return bundle;
      const k = fluxIndex(bundle, s);
      const meanT = flux.B_mean_T ? flux.B_mean_T[k] : bundle.meta.B_ref_T;
      return {
        ...bundle,
        // B_ref_T follows the slider: the shipped B arrays are already
        // divided by this surface's mean, so the readout has to name the
        // mean for the surface being shown, not the one the bundle was
        // built at.
        meta: { ...bundle.meta, s: flux.s[k], iota_s: flux.iota[k], B_ref_T: meanT },
        surface3d: {
          n_theta: flux.n_theta,
          n_zeta: flux.n_zeta,
          nfp_grid: flux.nfp_grid,
          s: flux.s[k],
          vertices: flux.vertices[k],
          B: flux.B[k],
        },
        boozer_B: {
          n_theta: flux.n_theta,
          n_zeta: flux.n_zeta,
          theta: flux.theta,
          zeta: flux.zeta,
          B: flux.boozer_B[k],
          xyz: flux.boozer_xyz ? flux.boozer_xyz[k] : (bundle.boozer_B && bundle.boozer_B.xyz),
          field_period_note: bundle.boozer_B && bundle.boozer_B.field_period_note,
        },
        cuts: flux.cuts[k],
      };
    }

    function activeBundle() {
      return bundleAtS(physicsBundle, Number(sSlider.value));
    }

    function formatS(s) {
      const v = Number(s);
      if (Math.abs(v - 1) < 1e-6) return '1.00';
      return v.toFixed(2);
    }

    function syncSReadout(s) {
      sVal.textContent = formatS(s);
    }

    function currentZeta() {
      const nfp = (physicsBundle && physicsBundle.meta.nfp) || 1;
      return Number(zetaSlider.value) * (2 * Math.PI) / nfp;
    }

    function cutProjection() {
      const el = document.querySelector('input[name="cutProj"]:checked');
      return (el && el.value) || 'RZ';
    }

    function updateZetaReadout() {
      zetaVal.textContent = currentZeta().toFixed(3);
    }

    function highlightSeedIndex(bundle) {
      return nearestPoincareSeedIndex(bundle, physicsSel);
    }

    function afterLayout(fn) {
      requestAnimationFrame(() => requestAnimationFrame(fn));
    }

    function physicsSceneOpts() {
      const bundle = activeBundle();
      const cut = bundle && bundle.cuts ? interpolatedCut(bundle, currentZeta()) : null;
      const hi = bundle ? highlightSeedIndex(bundle) : -1;
      const isCut = viewMode === 'boozerCut';
      const isP = viewMode === 'poincare';
      const isB = viewMode === 'boozerB';
      return {
        cmap: cmapSelect.value,
        showB: document.getElementById('showB').checked,
        // Not in Poincaré: the reading there is the puncture pattern on the
        // φ plane, and the axis curve is a bright line straight through the
        // middle of it. Its toggle is hidden in this mode too, so the
        // checkbox state is deliberately ignored rather than forced off --
        // it stays as the user left it for the Boozer modes.
        // No toggle for this any more: the axis is drawn everywhere except
        // Poincare, where it is meaningless on a puncture plot.
        showAxis: !isP,
        showAxes: document.getElementById('showAxes').checked,
        // The white ζ rim, always on in both Boozer modes -- it is what ties
        // the slider to a place on the device, so it is not a toggle. The
        // all-planes loops that used to sit beside it are gone; only the
        // swept cut is drawn.
        showCutPlane: isCut || isB,
        showPhiPlane: isP && document.getElementById('showPhiPlane').checked,
        showFieldLines: false,
        cutXyz: cut ? cut.xyz : null,
        zeta: currentZeta(),
        markerXyz: physicsSel && physicsSel.xyz,
        highlightSeed: hi,
        phi: Number(phiSlider.value) || 0,
      };
    }

    function paintPhysics2d() {
      const bundle = activeBundle();
      if (!bundle || viewMode === 'design') return;
      try {
        const nfp = bundle.meta.nfp || 1;
        const hi = highlightSeedIndex(bundle);
        const focusBoozer = viewMode === 'boozerCut' || viewMode === 'boozerB';
        if (bundle.boozer_B) {
          const period = (2 * Math.PI) / nfp;
          const z = currentZeta();
          const u = (((z % period) + period) % period) / period;
          drawBoozerB(canvasBoozerB, bundle, {
            cmap: cmapSelect.value,
            nContours: Number(nContoursEl.value),
            contoursOn: document.getElementById('contoursOn').checked,
            marker: physicsSel,
            zetaLine: focusBoozer ? { u } : null,
            labelHost: bmapLabels,
          });
        }
        drawBoozerCut(canvasBoozerCut, bundle, currentZeta(), {
          projection: cutProjection(),
          marker: physicsSel,
          highlightZeta: focusBoozer,
        });
        drawPoincare(canvasPoincare, bundle, {
          cmap: cmapSelect.value,
          highlightSeed: hi,
        });
        const period = (2 * Math.PI) / nfp;
        const dZeta = period / EQUAL_CUTS;
        document.getElementById('caption-boozer-cut').innerHTML =
          tex(`\\Delta\\zeta = ${dZeta.toFixed(2)}`) + ` · ${EQUAL_CUTS} slices`;
        const nSeedLines = bundle.poincare && bundle.poincare.seeds ? bundle.poincare.seeds.length : 0;
        const nSurf = bundle.poincare && bundle.poincare.surfaces_s ? bundle.poincare.surfaces_s.length : 0;
        const perSurf = nSurf ? Math.round(nSeedLines / nSurf) : 0;
        const phi = (bundle.poincare && bundle.poincare.phi) || 0;
        document.getElementById('caption-poincare').innerHTML =
          tex(`\\varphi = ${phi.toFixed(3)}`) + ` · ${nSurf} surfaces · ${perSurf} seeds`;
      } catch (err) {
        console.error(err);
      }
    }

    function paintPhysics3d() {
      const bundle = activeBundle();
      if (!bundle || viewMode === 'design') return;
      physicsScene.setBundle(bundle, physicsSceneOpts());
      physicsScene.resize();
    }

    function paintPhysics() {
      paintPhysics3d();
      paintPhysics2d();
    }

    function setPhysicsReadout(bundle) {
      if (!bundle) {
        physicsReadout.innerHTML = '';
        document.getElementById('bRangeVal').textContent = 'auto';
        return;
      }
      const m = bundle.meta;
      // The solver/iota/⟨B⟩ summary line is deliberately not rendered. The
      // numbers still reach the panel rows below (resolution, |B|/⟨B⟩
      // range) and the colorbar, which is where they are read from.
      physicsReadout.innerHTML = '';
      document.getElementById('bRangeVal').textContent =
        `[${m.B_min.toFixed(2)}, ${m.B_max.toFixed(2)}]`;
      const flux = bundle.flux;
      if (flux) {
        document.getElementById('resVal').textContent = `${flux.n_theta} × ${flux.n_zeta}`;
      }
      document.getElementById('nCutsVal').textContent = String(EQUAL_CUTS);
    }

    // Written once: the colormap is dimensionless and the reason is not
    // guessable from the plot. The two codes normalize the toroidal flux
    // differently, so their raw tesla differ by a constant factor; dividing
    // by the surface mean cancels it and leaves the modulation, which is
    // the physically comparable quantity.
    function setBNormNote() {
      document.getElementById('bNormNote').innerHTML =
        `Plots show ${tex(B_NORM)}, not tesla — the backends use different flux ` +
        `conventions, so only the ratio is comparable. ` +
        `${tex('\\langle|\\vec{B}|\\rangle')} in tesla is in the readout.`;
    }

    setBNormNote();

    function setPhysicsMode(mode) {
      viewMode = mode;
      applyModeChrome();
      if (viewMode !== 'design') loadPhysicsForCurrent();
    }

    function applyModeChrome() {
      const isDesign = viewMode === 'design';
      // A mode switch can hide the map without the pointer ever leaving it,
      // which would strand the ghost on the torus.
      clearBmapHover();
      document.getElementById('app').dataset.mode = viewMode;
      wrap.classList.toggle('hidden', !isDesign);
      physicsWrap.classList.toggle('visible', !isDesign);
      physicsCard.classList.toggle('visible', !isDesign);
      const designFilters = document.getElementById('designFilters');
      designFilters.hidden = !isDesign;
      designFilters.style.display = isDesign ? '' : 'none';
      document.getElementById('boozerBCtrls').style.display = viewMode === 'boozerB' ? '' : 'none';
      document.getElementById('boozerCutCtrls').style.display = viewMode === 'boozerCut' ? '' : 'none';
      document.getElementById('poincareCtrls').style.display = viewMode === 'poincare' ? '' : 'none';
      document.querySelectorAll('#modeSwitch button').forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.mode === viewMode);
      });
      document.querySelectorAll('#physics-analysis .analysis-panel').forEach((panel) => {
        panel.classList.toggle('active', panel.dataset.mode === viewMode);
      });
      physicsAnalysis.dataset.focus = isDesign ? '' : viewMode;
      const explain = modeExplain(viewMode);
      physicsCardTitle.textContent = explain.title || 'Physics';
      if (explain.title) {
        physicsExplain.innerHTML =
          `<b>${explain.title}</b>${explain.body}<div class="detail">${explain.detail}</div>`;
        physicsExplain.style.display = '';
      } else {
        physicsExplain.style.display = 'none';
      }
      afterLayout(() => {
        if (viewMode === 'design') resizeThree();
        else {
          physicsScene.resize();
          paintPhysics();
        }
      });
    }

    async function loadPhysicsForCurrent() {
      const gi = currentGi();
      if (gi == null || viewMode === 'design') return;
      if (physicsAbort) physicsAbort.abort();
      physicsAbort = new AbortController();
      const body = physicsRequestBody(gi);
      statusEl.textContent = 'loading…';
      try {
        const bundle = await requestPhysics(body, {
          signal: physicsAbort.signal,
          onStatus: (msg) => { statusEl.textContent = msg; },
        });
        if (currentGi() !== gi || viewMode === 'design') return;
        physicsBundle = bundle;
        const active = activeBundle();
        if (physicsSel) physicsSel = refreshSelectionXyz(active, physicsSel);
        setPhysicsReadout(active);
        updateZetaReadout();
        afterLayout(() => paintPhysics());
      } catch (err) {
        if (err.name === 'AbortError') return;
        statusEl.textContent = physicsErrorText(err, body.backend);
        physicsBundle = null;
        setPhysicsReadout(null);
      }
    }

    /** Turn a service error into one readable line.

    Both backends serve pre-solved equilibria only, so the common failure is
    simply "this candidate has no saved equilibrium for that backend" -- worth
    saying plainly instead of leaking `physics job 500: {"detail":...}`. */
    function physicsErrorText(err, backend) {
      const raw = String((err && err.message) || err);
      let detail = raw;
      const brace = raw.indexOf('{');
      if (brace !== -1) {
        try {
          const parsed = JSON.parse(raw.slice(brace));
          if (parsed && parsed.detail) detail = String(parsed.detail);
        } catch { /* not JSON; keep the raw text */ }
      }
      if (/no saved (VMEC\+\+|DESC)/i.test(detail) || /FileNotFoundError/.test(detail)) {
        const name = backend === 'vmecpp' ? 'VMEC++' : 'DESC';
        return `no saved ${name} equilibrium for this candidate`;
      }
      return detail;
    }

    document.getElementById('modeSwitch').addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-mode]');
      if (!btn) return;
      setPhysicsMode(btn.dataset.mode);
    });
    physicsAnalysis.addEventListener('click', (e) => {
      if (e.target.closest('canvas')) return;
      const panel = e.target.closest('.analysis-panel[data-mode]');
      if (!panel) return;
      setPhysicsMode(panel.dataset.mode);
    });
    // Hover preview: the same pick the click uses, but it only paints the
    // overlay and slides a ghost along the 3D surface. Nothing is committed
    // -- the pinned selection, the ζ slider and the other panels stay put.
    // rAF-throttled, since mousemove fires far faster than a frame.
    function flushHover() {
      hoverQueued = false;
      const bundle = activeBundle();
      const pick = hoverPick;
      drawBoozerBHover(bmapHover, canvasBoozerB, bundle, pick);
      const sel = pick && bundle && bundle.boozer_B
        ? selectionFromHeatmap(bundle, pick)
        : null;
      physicsScene.setHoverMarker(sel && sel.xyz);
    }
    function queueHover(pick) {
      hoverPick = pick;
      if (hoverQueued) return;
      hoverQueued = true;
      requestAnimationFrame(flushHover);
    }
    function clearBmapHover() {
      hoverPick = null;
      if (bmapHover) bmapHover.dataset.on = '0';
      physicsScene.setHoverMarker(null);
    }
    canvasBoozerB.addEventListener('mousemove', (e) => {
      const bundle = activeBundle();
      if (!bundle || !bundle.boozer_B) return;
      const bb = bundle.boozer_B;
      queueHover(heatmapPick(
        canvasBoozerB, e.clientX, e.clientY, bb.n_theta, bb.n_zeta, bundle.meta.nfp || 1,
      ));
    });
    canvasBoozerB.addEventListener('mouseleave', clearBmapHover);
    canvasBoozerB.addEventListener('click', (e) => {
      const bundle = activeBundle();
      if (!bundle || !bundle.boozer_B) return;
      const bb = bundle.boozer_B;
      const pick = heatmapPick(
        canvasBoozerB, e.clientX, e.clientY, bb.n_theta, bb.n_zeta, bundle.meta.nfp || 1,
      );
      if (!pick) return;
      physicsSel = selectionFromHeatmap(bundle, pick);
      const nfp = bundle.meta.nfp || 1;
      const period = (2 * Math.PI) / nfp;
      const frac = ((physicsSel.zetaB / period) % 1 + 1) % 1;
      const k = Math.round(frac * EQUAL_CUTS) % EQUAL_CUTS;
      zetaSlider.value = String(k / EQUAL_CUTS);
      updateZetaReadout();
      paintPhysics();
    });

    sSlider.addEventListener('input', () => {
      if (physicsBundle) {
        const bundle = activeBundle();
        syncSReadout(bundle.meta.s);
        if (physicsSel) physicsSel = refreshSelectionXyz(bundle, physicsSel);
        setPhysicsReadout(bundle);
        paintPhysics();
      } else {
        syncSReadout(sSlider.value);
      }
    });
    cmapSelect.addEventListener('change', paintPhysics);
    eqBackendEl.addEventListener('change', () => {
      physicsBundle = null;
      if (viewMode !== 'design') loadPhysicsForCurrent();
    });
    nContoursEl.addEventListener('input', () => {
      nContoursVal.textContent = nContoursEl.value;
      paintPhysics2d();
    });
    document.getElementById('contoursOn').addEventListener('change', paintPhysics2d);
    zetaSlider.addEventListener('input', () => {
      updateZetaReadout();
      if (physicsSel && physicsBundle) {
        physicsSel = refreshSelectionXyz(activeBundle(), { ...physicsSel, zetaB: currentZeta() });
      }
      paintPhysics();
    });
    phiSlider.addEventListener('input', () => {
      phiVal.textContent = Number(phiSlider.value).toFixed(2);
      if (viewMode === 'poincare') paintPhysics3d();
    });
    phiSlider.addEventListener('change', () => loadPhysicsForCurrent());
    nSeedsEl.addEventListener('change', () => loadPhysicsForCurrent());
    nTurnsEl.addEventListener('change', () => loadPhysicsForCurrent());
    document.querySelectorAll('input[name="cutProj"]').forEach((el) => {
      el.addEventListener('change', paintPhysics2d);
    });
    ['showB', 'showAxes', 'showPhiPlane'].forEach((id) => {
      document.getElementById(id).addEventListener('change', paintPhysics);
    });
    document.getElementById('resetPhysicsView').addEventListener('click', () => physicsScene.resetView());

    new ResizeObserver(() => {
      if (viewMode !== 'design') paintPhysics2d();
    }).observe(physicsAnalysis);


    // The 3D view and the UMAP map now live in separate, independently
    // resizable/collapsible panes, so each gets its own resize function
    // driven by a ResizeObserver on its own container (catches both window
    // resizes and the side-pane collapse/expand transition).
    function resizeThree() {
      const w = wrap.clientWidth, h = wrap.clientHeight;
      if (w < 2 || h < 2) return;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    function resizeUMAP() {
      const w = umapCanvasWrap.clientWidth, h = umapCanvasWrap.clientHeight;
      const dpr = window.devicePixelRatio || 1;
      tsneCanvas.width = w * dpr;
      tsneCanvas.height = h * dpr;
      tsneCanvas.style.width = `${w}px`;
      tsneCanvas.style.height = `${h}px`;
      if (tsnePoints) drawTSNE();
    }
    new ResizeObserver(resizeThree).observe(wrap);
    new ResizeObserver(resizeUMAP).observe(umapCanvasWrap);

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }

    // Panes are resized by dragging the same strip that also toggles
    // collapse -- a plain click (no meaningful mouse movement) collapses/
    // expands as before; a drag past DRAG_THRESHOLD instead resizes the
    // pane and leaves it expanded at the new width. Width is tracked in JS
    // (not left to CSS) so a later expand-after-collapse restores exactly
    // the size the user last dragged it to, rather than snapping back to
    // the 340px default.
    const DRAG_THRESHOLD = 4;
    const MIN_PANE = 220, MAX_PANE = 640;

    function setupPaneResizer(toggleBtn, pane, side, collapsedChar, expandedChar) {
      let width = pane.getBoundingClientRect().width || 340;
      let collapsed = false;
      let dragging = false, moved = false, startX = 0, startWidth = 0;

      function apply() {
        pane.style.flex = collapsed ? '0 0 0px' : `0 0 ${width}px`;
        toggleBtn.textContent = collapsed ? collapsedChar : expandedChar;
      }
      apply();

      toggleBtn.addEventListener('mousedown', (e) => {
        // Always registered, even while collapsed -- a plain click here
        // must still expand it (only actual dragging is skipped below,
        // since there's no meaningful width to drag from while at 0).
        dragging = true; moved = false;
        startX = e.clientX; startWidth = width; // width retains the last expanded size across a collapse
        e.preventDefault();
        window.addEventListener('mousemove', onMove);
        window.addEventListener('mouseup', onUp);
      });

      function onMove(e) {
        if (collapsed) return; // dragging a collapsed pane isn't supported -- only click-to-expand is
        const delta = (e.clientX - startX) * (side === 'left' ? 1 : -1);
        if (!moved && Math.abs(delta) > DRAG_THRESHOLD) {
          moved = true;
          toggleBtn.classList.add('dragging');
          pane.classList.add('dragging');
        }
        if (!moved) return;
        width = Math.min(MAX_PANE, Math.max(MIN_PANE, startWidth + delta));
        apply();
      }

      function onUp() {
        window.removeEventListener('mousemove', onMove);
        window.removeEventListener('mouseup', onUp);
        dragging = false;
        toggleBtn.classList.remove('dragging');
        pane.classList.remove('dragging');
        if (!moved) {
          collapsed = !collapsed;
          apply();
        }
      }
    }

    setupPaneResizer(leftToggle, leftPane, 'left', '›', '‹');
    setupPaneResizer(rightToggle, rightPane, 'right', '‹', '›');

    document.getElementById('tsneRecomputeBtn').addEventListener('click', () => computeAndRenderUMAP());
    tsneColorByEl.addEventListener('change', () => { if (tsnePoints) drawTSNE(); });

    // Blue -> yellow -> red, for a value already normalized to [0,1].
    function colorFor(frac) {
      const f = Math.max(0, Math.min(1, frac));
      const stops = [[58, 111, 216], [216, 201, 58], [216, 72, 58]];
      const seg = f < 0.5 ? 0 : 1;
      const local = f < 0.5 ? f * 2 : (f - 0.5) * 2;
      const a = stops[seg], b = stops[seg + 1];
      const r = Math.round(a[0] + (b[0] - a[0]) * local);
      const g = Math.round(a[1] + (b[1] - a[1]) * local);
      const bl = Math.round(a[2] + (b[2] - a[2]) * local);
      return `rgb(${r},${g},${bl})`;
    }

    function computeAndRenderUMAP() {
      const SAMPLE_CAP = 1000;
      const pool = filteredIndices;
      if (pool.length === 0) {
        tsneStatusEl.textContent = 'no candidates match the current filters';
        tsnePoints = null;
        return;
      }
      const n = Math.min(SAMPLE_CAP, pool.length);
      // sample without replacement
      const shuffled = pool.slice();
      for (let i = shuffled.length - 1; i > 0 && i >= shuffled.length - n; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      const globalIndices = shuffled.slice(shuffled.length - n);

      const yCols = meta.y_cols;
      const raw = globalIndices.map((gi) => {
        const base = gi * yCols;
        const row = new Array(yCols);
        for (let t = 0; t < yCols; t++) row[t] = Y[base + t];
        return row;
      });

      // z-score normalize each metric so raw scale (qi ~0.01-0.3 vs. others
      // spanning orders of magnitude) doesn't dominate the distance metric
      const mean = new Array(yCols).fill(0);
      const std = new Array(yCols).fill(0);
      for (let t = 0; t < yCols; t++) {
        let m = 0;
        for (let i = 0; i < n; i++) m += raw[i][t];
        m /= n;
        mean[t] = m;
        let v = 0;
        for (let i = 0; i < n; i++) v += (raw[i][t] - m) ** 2;
        std[t] = Math.sqrt(v / n) || 1;
      }
      const features = raw.map((row) => row.map((v, t) => (v - mean[t]) / std[t]));

      if (n < 4) {
        tsnePoints = { globalIndices, positions: features.map(() => [0, 0]) };
        drawTSNE();
        tsneStatusEl.textContent = `${n.toLocaleString()} points sampled from ${pool.length.toLocaleString()} matching candidates`;
        return;
      }

      tsneStatusEl.textContent = `computing UMAP on ${n.toLocaleString()} points…`;
      const nNeighbors = Math.max(2, Math.min(15, n - 1));
      const umap = new UMAP({ nComponents: 2, nNeighbors });
      const nEpochs = umap.initializeFit(features);
      let epoch = 0;
      const stepsPerTick = 5;

      function tick() {
        const target = Math.min(epoch + stepsPerTick, nEpochs);
        for (; epoch < target; epoch++) umap.step();
        tsnePoints = { globalIndices, positions: umap.getEmbedding() };
        drawTSNE();
        if (epoch < nEpochs) {
          requestAnimationFrame(tick);
        } else {
          tsneStatusEl.textContent = `${n.toLocaleString()} points sampled from ${pool.length.toLocaleString()} matching candidates`;
        }
      }
      requestAnimationFrame(tick);
    }

    function drawTSNE() {
      const ctx = tsneCanvas.getContext('2d');
      const dpr = window.devicePixelRatio || 1;
      const w = tsneCanvas.width, h = tsneCanvas.height;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.fillStyle = '#0c0c0e';
      ctx.fillRect(0, 0, w, h);
      if (!tsnePoints) return;

      const { positions, globalIndices } = tsnePoints;
      let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
      for (const [x, y] of positions) {
        if (x < minX) minX = x; if (x > maxX) maxX = x;
        if (y < minY) minY = y; if (y > maxY) maxY = y;
      }
      const pad = 40 * dpr;
      const spanX = (maxX - minX) || 1, spanY = (maxY - minY) || 1;
      const scale = Math.min((w - 2 * pad) / spanX, (h - 2 * pad) / spanY);
      const toPx = (x, y) => [
        pad + (x - minX) * scale + (w - 2 * pad - spanX * scale) / 2,
        pad + (y - minY) * scale + (h - 2 * pad - spanY * scale) / 2,
      ];

      // Color bounds come from the values actually plotted right now (not
      // the fixed global range) so the full blue->yellow->red spectrum is
      // always in use, even when filters/zoom have narrowed the sample to a
      // tight sub-range of a metric.
      const byMetric = tsneColorByEl.value !== 'source';
      const t = byMetric ? Number(tsneColorByEl.value) : 0;
      let cmin = Infinity, cmax = -Infinity;
      if (byMetric) {
        for (const gi of globalIndices) {
          const v = Y[gi * meta.y_cols + t];
          if (v < cmin) cmin = v;
          if (v > cmax) cmax = v;
        }
        if (cmin > cmax) { cmin = 0; cmax = 1; }
      }
      tsneLegendEl.style.visibility = byMetric ? 'visible' : 'hidden';
      tsneLegendMinEl.textContent = byMetric ? round5(cmin) : '';
      tsneLegendMaxEl.textContent = byMetric ? round5(cmax) : '';

      const currentGi = filteredIndices[Math.max(0, Math.min(filteredIndices.length - 1, Number(indexEl.value) || 0))];
      const sampleCounts = {};

      for (let i = 0; i < globalIndices.length; i++) {
        const gi = globalIndices[i];
        const [px, py] = toPx(positions[i][0], positions[i][1]);
        const isCurrent = gi === currentGi;
        const srcCode = sourceCodeOf(gi);
        sampleCounts[srcCode] = (sampleCounts[srcCode] || 0) + 1;
        const dimmed = hoveredSourceCode !== null && srcCode !== hoveredSourceCode;
        const highlighted = hoveredSourceCode !== null && srcCode === hoveredSourceCode;

        let fillStyle;
        if (byMetric) {
          const v = Y[gi * meta.y_cols + t];
          const frac = (v - cmin) / ((cmax - cmin) || 1);
          fillStyle = colorFor(frac);
        } else {
          fillStyle = SOURCE_COLORS[srcCode % SOURCE_COLORS.length];
        }

        ctx.globalAlpha = dimmed ? 0.15 : 1;
        const r = (isCurrent ? 7 : highlighted ? 5.5 : 4) * dpr;
        ctx.beginPath();
        ctx.arc(px, py, r, 0, 2 * Math.PI);
        ctx.fillStyle = fillStyle;
        ctx.fill();
        if (isCurrent) {
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 2 * dpr;
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
      }

      for (const [code, els] of Object.entries(sourceCardEls)) {
        const n = sampleCounts[code] || 0;
        els.countEl.textContent = `${n.toLocaleString()}/${globalIndices.length.toLocaleString()}`;
      }
    }

    tsneCanvas.addEventListener('click', (e) => {
      if (!tsnePoints) return;
      const rect = tsneCanvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      const clickX = (e.clientX - rect.left) * dpr, clickY = (e.clientY - rect.top) * dpr;

      const w = tsneCanvas.width, h = tsneCanvas.height;
      const { positions } = tsnePoints;
      let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
      for (const [x, y] of positions) {
        if (x < minX) minX = x; if (x > maxX) maxX = x;
        if (y < minY) minY = y; if (y > maxY) maxY = y;
      }
      const pad = 40 * dpr;
      const spanX = (maxX - minX) || 1, spanY = (maxY - minY) || 1;
      const scale = Math.min((w - 2 * pad) / spanX, (h - 2 * pad) / spanY);
      const toPx = (x, y) => [
        pad + (x - minX) * scale + (w - 2 * pad - spanX * scale) / 2,
        pad + (y - minY) * scale + (h - 2 * pad - spanY * scale) / 2,
      ];

      let best = -1, bestDist = 12 * dpr; // hit radius in device pixels
      for (let i = 0; i < positions.length; i++) {
        const [px, py] = toPx(positions[i][0], positions[i][1]);
        const dd = Math.hypot(px - clickX, py - clickY);
        if (dd < bestDist) { bestDist = dd; best = i; }
      }
      if (best < 0) return;
      const gi = tsnePoints.globalIndices[best];
      const pos = filteredIndices.indexOf(gi);
      if (pos < 0) return; // shouldn't happen -- sampled from filteredIndices itself
      indexEl.value = pos;
      renderCandidate();
      drawTSNE();
    });

    function percentileOf(t, gi, scopeStart, scopeCount) {
      const v = Y[gi * meta.y_cols + t];
      let below = 0;
      for (let i = 0; i < scopeCount; i++) {
        if (Y[(scopeStart + i) * meta.y_cols + t] <= v) below++;
      }
      return Math.round((below / scopeCount) * 100);
    }

    function renderCandidate() {
      if (filteredIndices.length === 0) {
        globalRowEl.textContent = '–';
        nfpValEl.textContent = '–';
        if (mesh) { scene.remove(mesh); mesh.geometry.dispose(); mesh = null; }
        currentValues = new Array(meta.y_cols).fill(null);
        meta.target_names.forEach((_, t) => {
          document.getElementById(`cur-${t}`).textContent = '–';
          document.getElementById(`pct-${t}`).textContent = '';
          drawHistogram(t, lastCounts[t] || new Array(N_BINS).fill(0));
        });
        if (tsnePoints) drawTSNE();
        if (viewMode !== 'design') loadPhysicsForCurrent();
        return;
      }
      const pos = Math.max(0, Math.min(filteredIndices.length - 1, Number(indexEl.value) || 0));
      const gi = filteredIndices[pos];
      const rowStart = gi * meta.x_cols;
      const nfp = X[rowStart + 90];

      if (mesh) { scene.remove(mesh); mesh.geometry.dispose(); }
      const geometry = buildGeometry(rowStart, nfp);
      mesh = new THREE.Mesh(geometry, material);
      scene.add(mesh);

      globalRowEl.textContent = gi.toLocaleString();
      nfpValEl.textContent = nfp;

      const { start: scopeStart, count: scopeCount } = sourceScope();
      const yStart = gi * meta.y_cols;
      meta.target_names.forEach((name, t) => {
        const v = Y[yStart + t];
        currentValues[t] = v;
        document.getElementById(`cur-${t}`).textContent = fmt(v);
        const pct = percentileOf(t, gi, scopeStart, scopeCount);
        document.getElementById(`pct-${t}`).textContent = `${pct}th percentile`;
        drawHistogram(t, lastCounts[t] || new Array(N_BINS).fill(0));
      });
      if (tsnePoints) drawTSNE();
      if (viewMode !== 'design') loadPhysicsForCurrent();
    }

    sourceEl.addEventListener('change', () => { indexEl.value = 0; recomputeFiltered(); });
    indexEl.addEventListener('change', renderCandidate);
    document.getElementById('prevBtn').addEventListener('click', () => {
      indexEl.value = Math.max(0, Number(indexEl.value) - 1);
      renderCandidate();
    });
    document.getElementById('nextBtn').addEventListener('click', () => {
      indexEl.value = Math.min(filteredIndices.length - 1, Number(indexEl.value) + 1);
      renderCandidate();
    });
    document.getElementById('randomBtn').addEventListener('click', () => {
      indexEl.value = Math.floor(Math.random() * filteredIndices.length);
      renderCandidate();
    });

    (async () => {
      await loadData();
      recomputeFiltered();
      computeAndRenderUMAP();
      animate();
      afterLayout(resizeThree);
    })();
  </script>
</body>
</html>
