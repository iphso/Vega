              <label for="nContours">contours</label>
              <input id="nContours" type="range" min="0" max="16" step="1" value="8" />
              <span class="val" id="nContoursVal">8</span>
            </div>
          </div>

          <div class="toggle-row">
            <label><input type="checkbox" id="showB" checked /> <span id="math-B-surf"></span> on surface</label>
            <label><input type="checkbox" id="showAxes" checked /> axes</label>
