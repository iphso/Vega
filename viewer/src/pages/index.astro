---
import 'katex/dist/katex.min.css';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Vega candidate viewer</title>
  <style is:global>
    :root {
      --bg: #0c0c0e;
      --panel: #16161a;
      --card: #1c1c21;
      --card-2: #202027;
      --border: #2a2a30;
      --text: #e8e8ec;
      --text-dim: #8a8a94;
      --text-faint: #55555e;
      --accent: #5b9dff;
      --accent-dim: #2a4a75;
      --handle: #ffb454;
      --radius: 10px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font-family: -apple-system, "Segoe UI", system-ui, sans-serif; }
    #app { display: flex; height: 100%; }

    .katex { font-size: 1.05em; color: inherit; }
    .katex .mord, .katex .mrel, .katex .mbin { color: inherit; }

    .side-pane { flex: 0 0 340px; overflow: hidden; transition: flex-basis .18s ease; }
    .side-pane.dragging { transition: none; }
    .side-pane .pane-content { width: 100%; height: 100%; overflow-y: auto; padding: 18px; }
    .side-pane .pane-content::-webkit-scrollbar { width: 8px; }
    .side-pane .pane-content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    #leftPane .pane-content { background: var(--panel); border-right: 1px solid var(--border); display: flex; flex-direction: column; }
    #rightPane .pane-content { background: var(--panel); border-left: 1px solid var(--border); }

    .pane-toggle-btn {
      flex: 0 0 18px; width: 18px; padding: 0; border: none; border-radius: 0;
      background: var(--panel); color: var(--text-faint); cursor: ew-resize; font-size: 11px;
      touch-action: none;
    }
    .pane-toggle-btn:hover, .pane-toggle-btn.dragging { background: var(--card-2); color: var(--text); }
    #leftToggle { border-right: 1px solid var(--border); }
    #rightToggle { border-left: 1px solid var(--border); }

    #centerPane { flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column; padding-bottom: 16px; }
    #topBar { padding: 18px 18px 0; flex: 0 0 auto; }
    #stage { flex: 1; min-height: 0; position: relative; }
    #canvas-wrap, #physics-wrap {
      position: absolute; inset: 0;
    }
    #canvas-wrap { display: block; }
    #canvas-wrap canvas { display: block; }
    #canvas-wrap.hidden { display: none; }

    .mode-switch { display: flex; gap: 0; margin-top: 12px; }
    .mode-switch button { flex: 1; border-radius: 0; }
    .mode-switch button + button { margin-left: -1px; }
    .mode-switch button:first-child { border-radius: 6px 0 0 6px; }
    .mode-switch button:last-child { border-radius: 0 6px 6px 0; }
    .mode-switch button.active { background: var(--accent-dim); border-color: var(--accent); }

    #physics-wrap { display: none; min-height: 0; }
    #physics-wrap.visible {
      display: grid;
      grid-template-rows: minmax(120px, 42%) minmax(240px, 58%);
    }
    #physics-3d { min-height: 0; min-width: 0; position: relative; overflow: hidden; }
    #physics-3d canvas { display: block; width: 100% !important; height: 100% !important; }
    #physics-analysis {
      min-height: 0; min-width: 0; display: grid; gap: 0;
      grid-template-columns: 1fr 1fr 1fr;
      overflow: hidden;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    #physics-analysis[data-focus="poincare"] { grid-template-columns: 1.45fr 1fr 1fr; }
    #physics-analysis[data-focus="boozerCut"] { grid-template-columns: 1fr 1.45fr 1fr; }
    #physics-analysis[data-focus="boozerB"] { grid-template-columns: 1fr 1fr 1.45fr; }
    .analysis-panel {
      min-width: 0; min-height: 0; display: flex; flex-direction: column; overflow: hidden;
      border-right: 1px solid var(--border); cursor: pointer; background: var(--bg);
    }
    .analysis-panel:last-child { border-right: none; }
    .analysis-panel.active { box-shadow: inset 0 2px 0 var(--accent); background: #101014; }
    .analysis-panel .panel-label {
      flex: 0 0 auto; font-size: 11px;
      color: var(--text-faint); padding: 6px 10px 0; font-weight: 600;
    }
    .analysis-panel .panel-sub {
      flex: 0 0 auto; font-size: 10px; color: var(--text-faint);
      padding: 0 10px 2px;
    }
    .analysis-panel.active .panel-label { color: var(--accent); }
    .plot-frame { flex: 1; min-height: 140px; position: relative; }
    .plot-frame canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    .axis-x, .axis-y, .plot-caption {
      position: absolute; pointer-events: none; color: var(--text-dim); z-index: 1;
    }
    .axis-x { bottom: 6px; left: 50%; transform: translateX(-20%); font-size: 12px; }
    .axis-y {
      left: 2px; top: 50%; transform: translateY(-50%) rotate(-90deg);
      transform-origin: center; font-size: 12px; white-space: nowrap;
    }
    .plot-caption { top: 8px; left: 44px; font-size: 11px; color: var(--text-faint); }
    .panel-hint { color: var(--accent); opacity: 0.75; }
    /* KaTeX axis/colorbar labels pinned over the heatmap canvas. Children
       are absolutely placed by the drawing code from the plot geometry;
       pointer-events stay off so the canvas keeps its click picking. */
    .plot-labels {
      position: absolute; inset: 0; pointer-events: none; z-index: 1;
      font-size: 11px; color: var(--text-dim);
    }
    .plot-labels > div { position: absolute; white-space: nowrap; line-height: 1; }
    .plot-labels .hm-tick { font-size: 10px; }
    /* Casing for the white-on-any-colormap ζ mark is set inline where the
       flag is placed, next to the canvas stroke it has to match. */
    .plot-labels .hm-flag { font-size: 12px; font-weight: 600; }
    /* Hover chrome: same overlay trick, but built once and only mutated,
       so a mousemove never repaints the heatmap. */
    .plot-hover { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
    .plot-hover[data-on="0"] { display: none; }
    .hm-cross {
      position: absolute; transform: translate(-50%, -50%);
      border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 2px;
      box-shadow: 0 0 0 1px rgba(8, 8, 12, 0.75);
    }
    .hm-tip {
      position: absolute; background: rgba(12, 12, 16, 0.92);
      border: 1px solid var(--border); border-radius: 5px; padding: 4px 7px;
      font-size: 10px; color: var(--text); white-space: nowrap;
      display: grid; gap: 1px;
    }
    .hm-tip > div { display: flex; gap: 6px; align-items: baseline; }
    .hm-tip .k { color: var(--text-dim); min-width: 22px; }
    .hm-tip .v { font-variant-numeric: tabular-nums; margin-left: auto; }
    .analysis-panel[data-mode="boozerCut"] .axis-x,
    .analysis-panel[data-mode="boozerCut"] .axis-y,
    .analysis-panel[data-mode="poincare"] .axis-x,
    .analysis-panel[data-mode="poincare"] .axis-y { display: none; }
    #canvas-boozer-b { cursor: crosshair; }
    .explain-box {
      font-size: 12px; color: var(--text-dim); line-height: 1.45;
      background: var(--card-2); border-radius: 8px; padding: 10px 12px; margin-top: 8px;
    }
    .explain-box b { color: var(--text); display: block; margin-bottom: 4px; font-size: 12px; }
    .explain-box .detail { color: var(--text-faint); margin-top: 6px; font-size: 11px; }
    /* "i in a bubble" hover tooltip for the metric-header -- one plain
       sentence (METRIC_INFO[name].short), the full explanation lives on
       the per-domain glossary page instead (see metricInfo.ts). Pure CSS,
       no JS needed for the hover itself. */
    .info-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 15px; height: 15px; border-radius: 50%; flex: 0 0 auto;
      background: var(--card-2); border: 1px solid var(--border);
      color: var(--text-faint); font-size: 10px; font-style: italic; font-family: Georgia, "Times New Roman", serif;
      cursor: help; position: relative;
    }
    .info-icon:hover { color: var(--accent); border-color: var(--accent-dim); }
    /* JS-driven, not pure-CSS ::after: .metric-card has overflow:hidden
       (keeps the collapsed row's corners clean against the card's own
       border-radius), which silently clips any absolutely-positioned
       child that escapes the row's own bounds -- confirmed by trying the
       simpler ::after approach first and watching it get clipped in every
       direction. position:fixed + JS-computed coordinates (below) escapes
       that ancestor's overflow cleanly instead of fighting it. */
    .metric-tooltip {
      position: fixed; z-index: 100; width: 210px;
      background: #101014; border: 1px solid var(--border); border-radius: 6px;
      padding: 8px 10px; font-size: 11px; font-weight: 400; line-height: 1.4;
      color: var(--text-dim); pointer-events: none; box-shadow: 0 4px 16px rgba(0,0,0,0.4);
      opacity: 0; transition: opacity .1s ease; display: none;
    }
    .metric-tooltip.visible { display: block; opacity: 1; }
    .radio-col { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; font-size: 12px; color: var(--text-dim); }
    .radio-col legend, .radio-label {
      font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); margin-bottom: 2px;
    }
    .radio-col label { display: flex; align-items: center; gap: 8px; cursor: pointer; }

    .ctrl-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 8px; font-size: 12px; color: var(--text-dim); }
    .ctrl-row label { flex: 1; }
    .ctrl-row .val { flex: 0 0 52px; text-align: right; font-variant-numeric: tabular-nums; color: var(--text); }
    input[type=range] {
      display: block; width: 100%; margin: 6px 0 0; accent-color: var(--handle);
    }
    .ctrl-row input[type=range] {
      flex: 1 1 100%; width: 100%; min-width: 0; margin-top: 2px;
    }
    .ctrl-hint { font-size: 11px; color: var(--text-faint); margin-top: 2px; }
    /* The |B| normalization note. Slightly stronger than .ctrl-hint because
       it explains what the colormap units mean, which is not guessable. */
    .ctrl-note {
      font-size: 11px; line-height: 1.45; color: var(--text-dim);
      margin-top: 6px; padding: 6px 8px;
      border-left: 2px solid var(--text-faint);
      background: rgba(255, 255, 255, 0.03);
    }
    .ctrl-note .katex { font-size: 1em; }
    .phi-rad-labels {
      position: relative; height: 20px; margin-top: 2px;
      font-size: 15px; color: var(--text-dim);
    }
    .phi-rad-labels .mid {
      position: absolute; left: 50%; transform: translateX(-50%);
    }
    .phi-rad-labels .end { position: absolute; right: 0; }
    .s-ticks {
      display: flex; justify-content: space-between; margin-top: 2px;
      font-size: 10px; color: var(--text-faint); font-variant-numeric: tabular-nums;
    }
    .toggle-row { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; font-size: 12px; color: var(--text-dim); }
    .toggle-row label { display: flex; align-items: center; gap: 8px; cursor: pointer; }
    #physicsCard { display: none; }
    #physicsCard.visible { display: block; }
    /* Filters are Design-only; plot modes must not show this pane. */
    #app:not([data-mode="design"]) #designFilters,
    #app:not([data-mode="design"]) #matchBar,
    #app:not([data-mode="design"]) #filters {
      display: none !important;
    }
    /* Always empty now -- hidden so its margin does not leave a gap.
       Restoring the summary line means undoing this and the early return
       in setPhysicsReadout. */
    #physicsReadout { display: none; font-size: 11px; color: var(--text-dim); margin-top: 10px; line-height: 1.6; }
    #physicsReadout b { color: var(--text); font-weight: 600; }

    h1 { font-size: 15px; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
    /* Byline rides the title's baseline and is pushed to the far edge, so it
       reads as a credit on the header rather than a second line of subtitle. */
    #titleRow { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .domain-nav { display: flex; gap: 4px; margin-top: 8px; }
    .domain-nav a {
      font-size: 11px; color: var(--text-dim); text-decoration: none;
      padding: 4px 10px; border-radius: 20px; border: 1px solid var(--border);
      background: var(--card-2); transition: color .12s, border-color .12s;
    }
    .domain-nav a:hover { color: var(--text); border-color: #3a3a42; }
    .domain-nav a.active { color: var(--accent); border-color: var(--accent-dim); background: var(--accent-dim); }
    #byline { font-size: 11px; color: var(--text-faint); letter-spacing: 0.02em; white-space: nowrap; }
    #subtitle { font-size: 12px; color: var(--text-dim); margin-top: 2px; }

    .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px; margin-top: 14px; }
    .card:first-child { margin-top: 0; }
    .section-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint); font-weight: 600; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }

    select, input[type=number] {
      width: 100%; background: var(--card-2); color: var(--text); border: 1px solid var(--border);
      border-radius: 6px; padding: 7px 8px; font-size: 13px; font-family: inherit;
    }
    select:focus, input:focus { outline: none; border-color: var(--accent); }

    .btn-row { display: flex; gap: 6px; margin-top: 8px; }
    .btn-row button { flex: 1; }
    button {
      background: var(--card-2); color: var(--text); border: 1px solid var(--border); border-radius: 6px;
      padding: 7px 10px; cursor: pointer; font-size: 13px; font-family: inherit; transition: background .12s, border-color .12s;
    }
    button:hover { background: #26262e; border-color: #3a3a42; }
    button:active { background: #2c2c36; }
    button.icon { flex: 0 0 auto; width: 36px; font-weight: 600; }
    button.link, a.link { background: none; border: none; color: var(--accent); padding: 0; font-size: 11px; font-weight: 500; text-decoration: none; }
    button.link:hover, a.link:hover { background: none; text-decoration: underline; }

    .candidate-meta { display: flex; gap: 8px; margin-top: 10px; font-size: 11px; color: var(--text-dim); }
    .pill { background: var(--card-2); border: 1px solid var(--border); border-radius: 20px; padding: 3px 10px; }
    .pill b { color: var(--text); font-weight: 600; }

    #matchBar .track { height: 8px; background: var(--card-2); border-radius: 4px; overflow: hidden; margin-top: 6px; }
    #matchBar .fill { height: 100%; background: linear-gradient(90deg, var(--accent-dim), var(--accent)); border-radius: 4px; transition: width .15s ease; }
    #matchLabel { font-size: 13px; }
    #matchLabel b { color: var(--accent); }

    .metric-card { padding: 0; overflow: hidden; }
    .metric-card + .metric-card { margin-top: 8px; }

    .metric-header {
      width: 100%; display: flex; align-items: center; gap: 8px; background: none; border: none;
      border-radius: 0; padding: 12px 14px; text-align: left; font-family: inherit;
    }
    .metric-header:hover { background: #222229; }
    .metric-header:active { background: #222229; }
    .chevron { font-size: 10px; color: var(--text-faint); transition: transform .15s ease; flex: 0 0 auto; }
    .metric-card.expanded .chevron { transform: rotate(90deg); }
    .metric-name { font-size: 12.5px; color: #d4d4da; font-weight: 500; }
    .metric-value-inline {
      font-size: 13px; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums;
    }
    .metric-header .spacer { flex: 1; }
    .metric-pct { font-size: 10.5px; color: var(--accent); background: var(--accent-dim); padding: 3px 9px; border-radius: 20px; font-weight: 500; white-space: nowrap; flex: 0 0 auto; }

    .metric-body { display: none; padding: 0 14px 14px; }
    .metric-card.expanded .metric-body { display: block; }
    .body-toolbar { display: flex; justify-content: flex-end; margin-bottom: 4px; }

    .hist-wrap { position: relative; padding-bottom: 15px; }
    .hist-wrap canvas { width: 100%; height: 52px; display: block; border-radius: 4px; cursor: ew-resize; }
    .handle-label {
      position: absolute; bottom: 0; transform: translateX(-50%); font-size: 9px; color: #8a7860;
      font-variant-numeric: tabular-nums; cursor: text; padding: 1px 3px; border-radius: 3px; white-space: nowrap;
    }
    .handle-label:hover { background: rgba(255, 180, 84, 0.1); color: #b39770; }
    .handle-label input {
      width: 64px; font-size: 9px; padding: 1px 3px; background: var(--card-2); color: #b39770;
      border: 1px solid #6b5d47; border-radius: 3px; text-align: center;
    }

    #status { font-size: 11px; color: var(--text-faint); }
    #hint { font-size: 11px; color: var(--text-faint); margin-top: 6px; line-height: 1.5; }

    #umapCanvasWrap { flex: 1; position: relative; margin-top: 14px; min-height: 160px; }
    #candidateCard { flex: 0 0 auto; }
    #tsneCanvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: pointer; border-radius: var(--radius); background: #0c0c0e; }
    #tsneStatus { font-size: 11px; color: var(--text-dim); margin-top: 8px; }
    #tsneLegend { display: flex; align-items: center; gap: 6px; margin-top: 8px; font-size: 10px; color: var(--text-faint); }
    #tsneLegend .bar { flex: 1; height: 8px; border-radius: 4px; background: linear-gradient(90deg, #3a6fd8, #d8c93a, #d8483a); }

    .source-cards {
      position: absolute; top: 10px; left: 10px; right: 10px; display: flex; flex-wrap: wrap;
      gap: 6px; z-index: 5; pointer-events: none;
    }
    .source-card {
      pointer-events: auto; display: flex; align-items: center; gap: 6px;
      background: rgba(28, 28, 33, 0.88); border: 1px solid var(--border); border-radius: 8px;
      padding: 5px 10px; font-size: 11px; color: var(--text-dim); cursor: pointer;
      transition: border-color .12s, color .12s, background .12s;
    }
    .source-card:hover, .source-card.active {
      border-color: var(--src-color, var(--accent)); color: var(--text); background: rgba(38, 38, 46, 0.92);
    }
    .source-card .dot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; background: var(--src-color); }
    .source-card .name { font-weight: 500; }
    .source-card .count { color: var(--text-faint); font-variant-numeric: tabular-nums; }
  </style>
</head>
<body>
  <div id="app" data-mode="design">
    <div id="leftPane" class="side-pane">
      <div class="pane-content">
        <div class="card">
          <div class="section-title">UMAP map</div>
          <label for="tsneColorBy">Color by</label>
          <select id="tsneColorBy"></select>
          <div class="btn-row">
            <button id="tsneRecomputeBtn">recompute</button>
          </div>
          <div id="tsneStatus"></div>
          <div id="tsneLegend"><span id="tsneLegendMin"></span><span class="bar"></span><span id="tsneLegendMax"></span></div>
          <div id="hint">Points are up to 1000 randomly sampled from the current filtered set, positioned by similarity across all 11 metrics. Hover a source card to highlight it; click a point to inspect it.</div>
        </div>
        <div id="umapCanvasWrap">
          <canvas id="tsneCanvas"></canvas>
          <div id="sourceCards" class="source-cards"></div>
        </div>
        <div class="card" id="candidateCard">
          <div class="section-title">Candidate</div>
          <select id="source">
          </select>
          <div class="btn-row">
            <button class="icon" id="prevBtn">‹</button>
            <input id="index" type="number" min="0" value="0" />
            <button class="icon" id="nextBtn">›</button>
            <button id="randomBtn">random</button>
          </div>
          <div class="candidate-meta">
            <span class="pill">row <b id="globalRow">–</b></span>
            <span class="pill">nfp <b id="nfpVal">–</b></span>
          </div>
        </div>
      </div>
    </div>
    <button class="pane-toggle-btn" id="leftToggle">‹</button>

    <div id="centerPane">
      <div id="topBar">
        <div id="titleRow">
          <h1>Vega candidate viewer</h1>
          <span id="byline">made by IPH Labs</span>
        </div>
        <nav class="domain-nav">
          <a href="/" class="active">Stellarators</a>
          <a href="/airfoil">Airfoils</a>
          <a href="/torax">TORAX</a>
          <a href="/mug">Mug</a>
        </nav>
        <div id="subtitle">loading…</div>
        <div class="mode-switch" id="modeSwitch">
          <button type="button" data-mode="design" class="active">Design</button>
          <button type="button" data-mode="poincare">Poincaré</button>
          <button type="button" data-mode="boozerCut">Boozer Cut</button>
          <button type="button" data-mode="boozerB">Boozer B</button>
        </div>
      </div>
      <div id="stage">
      <div id="canvas-wrap"></div>
      <div id="physics-wrap">
        <div id="physics-3d"></div>
        <div id="physics-analysis" data-focus="poincare">
          <div class="analysis-panel" data-mode="poincare">
            <div class="panel-label">Poincaré · <span id="math-poincare-title"></span></div>
            <div class="panel-sub">physical R–Z geometry</div>
            <div class="plot-frame">
              <canvas id="canvas-poincare"></canvas>
              <div class="axis-y" id="axis-poincare-y"></div>
              <div class="axis-x" id="axis-poincare-x"></div>
              <div class="plot-caption" id="caption-poincare"></div>
            </div>
          </div>
          <div class="analysis-panel" data-mode="boozerCut">
            <div class="panel-label">Boozer Cut · <span id="math-cut-title"></span></div>
            <div class="panel-sub">physical R–Z geometry</div>
            <div class="plot-frame">
              <canvas id="canvas-boozer-cut"></canvas>
              <div class="axis-y" id="axis-cut-y"></div>
              <div class="axis-x" id="axis-cut-x"></div>
              <div class="plot-caption" id="caption-boozer-cut"></div>
            </div>
          </div>
          <div class="analysis-panel" data-mode="boozerB">
            <div class="panel-label">Boozer B map · <span id="math-bmap-title"></span></div>
            <div class="panel-sub">
              coordinate representation ·
              <span class="panel-hint">hover to preview on the 3D surface · click to pin</span>
            </div>
            <div class="plot-frame">
              <canvas id="canvas-boozer-b"></canvas>
              <div class="plot-labels" id="bmap-labels"></div>
              <div class="plot-hover" id="bmap-hover" data-on="0"></div>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>

    <button class="pane-toggle-btn" id="rightToggle">›</button>
    <div id="rightPane" class="side-pane">
      <div class="pane-content" id="panel">
        <div class="card" id="physicsCard">
          <div class="section-title" id="physicsCardTitle">Physics</div>
          <div id="physicsExplain" class="explain-box"></div>
          <div id="status">idle</div>
          <div class="ctrl-row">
