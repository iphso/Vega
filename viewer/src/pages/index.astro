            <span class="val" id="sVal">1.00</span>
          </div>
          <div class="ctrl-hint">3D / Boozer surface · Poincaré always shows all four</div>
          <input id="sSlider" type="range" min="0.25" max="1" step="0.25" value="1" />
          <div class="s-ticks"><span>0.25</span><span>0.50</span><span>0.75</span><span>1</span></div>
