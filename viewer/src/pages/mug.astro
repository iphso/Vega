---
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Vega Mug viewer</title>
  <style is:global>
    :root {
      --bg: #0c0c0e; --panel: #16161a; --card: #1c1c21; --card-2: #202027;
      --border: #2a2a30; --text: #e8e8ec; --text-dim: #8a8a94; --text-faint: #55555e;
      --accent: #5b9dff; --accent-dim: #2a4a75; --handle: #ffb454; --radius: 10px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font-family: -apple-system, "Segoe UI", system-ui, sans-serif; }
    #app { display: flex; height: 100%; }
    .side-pane { flex: 0 0 340px; overflow: hidden; }
    .side-pane .pane-content { width: 100%; height: 100%; overflow-y: auto; padding: 18px; }
    .side-pane .pane-content::-webkit-scrollbar { width: 8px; }
    .side-pane .pane-content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    #leftPane .pane-content { background: var(--panel); border-right: 1px solid var(--border); }
    #rightPane .pane-content { background: var(--panel); border-left: 1px solid var(--border); }
    #centerPane { flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column; padding: 18px; gap: 14px; overflow-y: auto; }

    h1 { font-size: 15px; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
    #titleRow { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    #byline { font-size: 11px; color: var(--text-faint); letter-spacing: 0.02em; white-space: nowrap; }
    #subtitle { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
    .domain-nav { display: flex; gap: 4px; margin-top: 8px; flex-wrap: wrap; }
    .domain-nav a {
      font-size: 11px; color: var(--text-dim); text-decoration: none;
      padding: 4px 10px; border-radius: 20px; border: 1px solid var(--border);
      background: var(--card-2); transition: color .12s, border-color .12s;
    }
    .domain-nav a:hover { color: var(--text); border-color: #3a3a42; }
    .domain-nav a.active { color: var(--accent); border-color: var(--accent-dim); background: var(--accent-dim); }

    .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px; margin-top: 14px; }
    .card:first-child { margin-top: 0; }
    .section-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint); font-weight: 600; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }

    select, input[type=number] {
      width: 100%; background: var(--card-2); color: var(--text); border: 1px solid var(--border);
      border-radius: 6px; padding: 7px 8px; font-size: 13px; font-family: inherit;
    }
    select:focus, input:focus { outline: none; border-color: var(--accent); }
    .btn-row { display: flex; gap: 6px; margin-top: 8px; }
    .btn-row button { flex: 1; }
    button {
      background: var(--card-2); color: var(--text); border: 1px solid var(--border); border-radius: 6px;
      padding: 7px 10px; cursor: pointer; font-size: 13px; font-family: inherit; transition: background .12s, border-color .12s;
    }
    button:hover { background: #26262e; border-color: #3a3a42; }
    button.icon { flex: 0 0 auto; width: 36px; font-weight: 600; }
    button.link, a.link { background: none; border: none; color: var(--accent); padding: 0; font-size: 11px; font-weight: 500; text-decoration: none; }
    button.link:hover, a.link:hover { background: none; text-decoration: underline; }
    .info-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 15px; height: 15px; border-radius: 50%; flex: 0 0 auto;
      background: var(--card-2); border: 1px solid var(--border);
      color: var(--text-faint); font-size: 10px; font-style: italic; font-family: Georgia, "Times New Roman", serif;
      cursor: help; position: relative;
    }
    .info-icon:hover { color: var(--accent); border-color: var(--accent-dim); }
    .metric-tooltip {
      position: fixed; z-index: 100; width: 210px;
      background: #101014; border: 1px solid var(--border); border-radius: 6px;
      padding: 8px 10px; font-size: 11px; font-weight: 400; line-height: 1.4;
      color: var(--text-dim); pointer-events: none; box-shadow: 0 4px 16px rgba(0,0,0,0.4);
      opacity: 0; transition: opacity .1s ease; display: none;
    }
    .metric-tooltip.visible { display: block; opacity: 1; }

    .candidate-meta { display: flex; gap: 8px; margin-top: 10px; font-size: 11px; color: var(--text-dim); flex-wrap: wrap; }
    .pill { background: var(--card-2); border: 1px solid var(--border); border-radius: 20px; padding: 3px 10px; }
    .pill b { color: var(--text); font-weight: 600; }
    .pill.src-real { border-color: #5bd88a; color: #5bd88a; }
    .pill.src-real b { color: #5bd88a; }

    #matchBar .track { height: 8px; background: var(--card-2); border-radius: 4px; overflow: hidden; margin-top: 6px; }
    #matchBar .fill { height: 100%; background: linear-gradient(90deg, var(--accent-dim), var(--accent)); border-radius: 4px; transition: width .15s ease; }
    #matchLabel { font-size: 13px; }
    #matchLabel b { color: var(--accent); }
    #hint { font-size: 11px; color: var(--text-faint); margin-top: 6px; line-height: 1.5; }

    .metric-card { padding: 0; overflow: hidden; }
    .metric-card + .metric-card { margin-top: 8px; }
    .metric-header {
      width: 100%; display: flex; align-items: center; gap: 8px; background: none; border: none;
      border-radius: 0; padding: 12px 14px; text-align: left; font-family: inherit;
    }
    .metric-header:hover { background: #222229; }
    .chevron { font-size: 10px; color: var(--text-faint); transition: transform .15s ease; flex: 0 0 auto; }
    .metric-card.expanded .chevron { transform: rotate(90deg); }
    .metric-name { font-size: 12.5px; color: #d4d4da; font-weight: 500; }
    .metric-value-inline { font-size: 13px; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
    .metric-header .spacer { flex: 1; }
    .metric-pct { font-size: 10.5px; color: var(--accent); background: var(--accent-dim); padding: 3px 9px; border-radius: 20px; font-weight: 500; white-space: nowrap; flex: 0 0 auto; }
    .metric-body { display: none; padding: 0 14px 14px; }
    .metric-card.expanded .metric-body { display: block; }
    .body-toolbar { display: flex; justify-content: flex-end; margin-bottom: 4px; }

    .hist-wrap { position: relative; padding-bottom: 15px; }
    .hist-wrap canvas { width: 100%; height: 52px; display: block; border-radius: 4px; cursor: ew-resize; }
    .handle-label {
      position: absolute; bottom: 0; transform: translateX(-50%); font-size: 9px; color: #8a7860;
      font-variant-numeric: tabular-nums; cursor: text; padding: 1px 3px; border-radius: 3px; white-space: nowrap;
    }
    .handle-label:hover { background: rgba(255, 180, 84, 0.1); color: #b39770; }
    .handle-label input { width: 64px; font-size: 9px; padding: 1px 3px; background: var(--card-2); color: #b39770; border: 1px solid #6b5d47; border-radius: 3px; text-align: center; }

    #umapCanvasWrap { position: relative; margin-top: 14px; height: 220px; }
    #umapCanvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: pointer; border-radius: var(--radius); background: #0c0c0e; }
    #umapStatus { font-size: 11px; color: var(--text-dim); margin-top: 8px; }
    #umapLegend { display: flex; align-items: center; gap: 6px; margin-top: 8px; font-size: 10px; color: var(--text-faint); }
    #umapLegend .bar { flex: 1; height: 8px; border-radius: 4px; background: linear-gradient(90deg, #3a6fd8, #d8c93a, #d8483a); }
    .source-cards { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; flex-wrap: wrap; gap: 6px; z-index: 5; pointer-events: none; }
    .source-card {
      pointer-events: auto; display: flex; align-items: center; gap: 6px;
      background: rgba(28, 28, 33, 0.88); border: 1px solid var(--border); border-radius: 8px;
      padding: 5px 10px; font-size: 11px; color: var(--text-dim); cursor: pointer;
      transition: border-color .12s, color .12s, background .12s;
    }
    .source-card:hover, .source-card.active { border-color: var(--src-color, var(--accent)); color: var(--text); background: rgba(38, 38, 46, 0.92); }
    .source-card .dot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; background: var(--src-color); }
    .source-card .count { color: var(--text-faint); font-variant-numeric: tabular-nums; }

    .viz-card { flex: 0 0 auto; }
    .viz-title { font-size: 12px; color: var(--text-dim); margin-bottom: 8px; display: flex; justify-content: space-between; }
    .viz-title .status { color: var(--text-faint); font-size: 11px; }
    #mug3dWrap { width: 100%; height: 380px; position: relative; background: #0c0c0e; border-radius: 8px; overflow: hidden; }
    #mug3dWrap canvas { display: block; width: 100% !important; height: 100% !important; }
    .mug-caption { font-size: 11px; color: var(--text-faint); margin-top: 8px; }
    .mug-legend { display: flex; align-items: center; gap: 10px; margin-top: 6px; font-size: 10px; color: var(--text-faint); flex-wrap: wrap; }
    .mug-legend .bar { width: 120px; height: 8px; border-radius: 4px; background: linear-gradient(90deg, #3a6fd8, #d8c93a, #d8483a); }
    .mug-legend .swatch { display: inline-flex; align-items: center; gap: 4px; }
    .mug-legend .dot { width: 8px; height: 8px; border-radius: 50%; }
    #tempChartCell { background: #0c0c0e; border-radius: 8px; padding: 8px; }
    #tempChartCanvas { width: 100%; height: 190px; display: block; }
    .time-row { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
    .time-row input[type=range] { flex: 1; accent-color: var(--handle); }
    .time-row .t-val { font-size: 11px; color: var(--text-dim); font-variant-numeric: tabular-nums; width: 70px; text-align: right; }
    .polar-row { display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap; }
    .polar-stat { background: var(--card-2); border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; flex: 1; min-width: 90px; }
    .polar-stat .k { font-size: 10px; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.05em; }
    .polar-stat .v { font-size: 15px; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; margin-top: 2px; }
  </style>
</head>
<body>
  <div id="app">
    <div id="leftPane" class="side-pane">
      <div class="pane-content">
        <div id="titleRow">
          <h1>Vega Mug viewer</h1>
          <span id="byline">made by IPH Labs</span>
        </div>
        <nav class="domain-nav">
          <a href="/">Stellarators</a>
          <a href="/airfoil">Airfoils</a>
          <a href="/torax">TORAX</a>
          <a href="/mug" class="active">Mug</a>
        </nav>
        <div id="subtitle">loading…</div>

        <div class="card" style="margin-top:14px">
          <div class="section-title">UMAP map</div>
          <label for="umapColorBy">Color by</label>
          <select id="umapColorBy"></select>
          <div class="btn-row"><button id="umapRecomputeBtn">recompute</button></div>
          <div id="umapStatus"></div>
          <div id="umapLegend"><span id="umapLegendMin"></span><span class="bar"></span><span id="umapLegendMax"></span></div>
          <div id="hint">Points are up to 800 randomly sampled from the current filtered set, positioned by similarity across the 4 target metrics. Click a point to inspect it.</div>
        </div>
        <div id="umapCanvasWrap">
          <canvas id="umapCanvas"></canvas>
          <div id="sourceCards" class="source-cards"></div>
        </div>

        <div class="card">
          <div class="section-title">Candidate</div>
          <select id="source"></select>
          <div class="btn-row">
            <button class="icon" id="prevBtn">‹</button>
            <input id="index" type="number" min="0" value="0" />
            <button class="icon" id="nextBtn">›</button>
            <button id="randomBtn">random</button>
          </div>
          <div class="candidate-meta">
            <span class="pill">row <b id="globalRow">–</b></span>
            <span class="pill">r_rim <b id="rRimVal">–</b> mm</span>
            <span class="pill">lid <b id="lidVal">–</b>%</span>
            <span class="pill">mass <b id="massVal">–</b> kg</span>
          </div>
        </div>
      </div>
    </div>

    <div id="centerPane">
      <div class="card viz-card">
        <div class="viz-title"><span>3D mug</span><span class="status" id="shapeStatus"></span></div>
        <div id="mug3dWrap"></div>
        <div class="mug-caption" id="mugCaption"></div>
        <div class="mug-legend">
          <span class="swatch"><span>cool</span></span><span class="bar"></span><span>hot (surface temp at the current time)</span>
        </div>
      </div>
      <div class="card viz-card" style="flex:1">
        <div class="viz-title"><span>Temperature over time (live simulation)</span><span class="status" id="profileStatus"></span></div>
        <div id="tempChartCell"><canvas id="tempChartCanvas"></canvas></div>
        <div class="mug-legend" id="chartLegend"></div>
        <div class="time-row">
          <button class="icon" id="playBtn">▶</button>
          <input id="timeSlider" type="range" min="0" max="120" step="1" value="120" />
          <span class="t-val" id="timeVal">t=–</span>
        </div>
        <div class="polar-row">
          <div class="polar-stat"><div class="k">temp @ 2h</div><div class="v" id="polarTemp2h">–</div></div>
          <div class="polar-stat"><div class="k">mass (kg)</div><div class="v" id="polarMass">–</div></div>
          <div class="polar-stat"><div class="k">touch @ 60s</div><div class="v" id="polarTouch">–</div></div>
          <div class="polar-stat"><div class="k">handle @ 60s</div><div class="v" id="polarHandle">–</div></div>
        </div>
      </div>
    </div>

    <div id="rightPane" class="side-pane">
      <div class="pane-content">
        <div class="card" id="matchBar">
          <div class="section-title">Filters<span style="display:flex; gap:10px; align-items:center;"><a class="link" href="/glossary/mug" target="_blank" rel="noopener">metric glossary ↗</a><button class="link" id="resetAllBtn">reset all</button></span></div>
          <div id="matchLabel"></div>
          <div class="track"><div class="fill" id="matchFill"></div></div>
          <div id="hint">Drag the amber handles to set a range. Click a handle's number to type one. Drag on open space to jump the nearest handle there.</div>
        </div>
        <div id="filters"></div>
      </div>
    </div>
  </div>
  <div id="metricTooltip" class="metric-tooltip"></div>

  <script>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
    import { UMAP } from 'umap-js';
    import { colormapHex } from '../lib/colormap';
    import { METRIC_INFO } from '../lib/metricInfo';

    const PHYSICS_URL = import.meta.env.PUBLIC_MUG_PHYSICS_URL || 'http://localhost:8093';
    const PARAM_NAMES = [
      'r_base_mm', 'r_mid_mm', 'r_rim_mm',
      't_wall_rim_mm', 't_wall_base_mm', 'struct_material_idx',
      't_gap_mm', 'insulation_material_idx',
      'handle_length_mm', 'handle_diameter_mm', 'handle_material_idx',
      'lid_coverage_frac', 't_lid_mm', 'lid_material_idx',
    ];
    // Fixed absolute color scale (ambient .. fill temperature) rather than a
    // per-frame min/max -- keeps the 3D shape's colors directly comparable
    // across the whole time slider instead of re-normalizing (and visually
    // flickering) every frame.
    const COLOR_MIN_C = 20, COLOR_MAX_C = 90;

    const subtitleEl = document.getElementById('subtitle');
    const sourceEl = document.getElementById('source');
    const indexEl = document.getElementById('index');
    const globalRowEl = document.getElementById('globalRow');
    const rRimValEl = document.getElementById('rRimVal');
    const lidValEl = document.getElementById('lidVal');
    const massValEl = document.getElementById('massVal');
    const matchLabelEl = document.getElementById('matchLabel');
    const matchFillEl = document.getElementById('matchFill');
    const filtersEl = document.getElementById('filters');
    const metricTooltipEl = document.getElementById('metricTooltip');
    filtersEl.addEventListener('mouseover', (e) => {
      const icon = e.target.closest('.info-icon');
      if (!icon) return;
      metricTooltipEl.textContent = icon.dataset.tip;
      const rect = icon.getBoundingClientRect();
      const left = Math.min(window.innerWidth - 222, Math.max(8, rect.left - 100));
      metricTooltipEl.style.left = `${left}px`;
      metricTooltipEl.style.top = `${rect.bottom + 6}px`;
      metricTooltipEl.classList.add('visible');
    });
    filtersEl.addEventListener('mouseout', (e) => {
      if (e.target.closest('.info-icon')) metricTooltipEl.classList.remove('visible');
    });
    const umapCanvas = document.getElementById('umapCanvas');
    const umapCanvasWrap = document.getElementById('umapCanvasWrap');
    const umapColorByEl = document.getElementById('umapColorBy');
    const umapStatusEl = document.getElementById('umapStatus');
    const umapLegendMinEl = document.getElementById('umapLegendMin');
    const umapLegendMaxEl = document.getElementById('umapLegendMax');
    const umapLegendEl = document.getElementById('umapLegend');
    const sourceCardsEl = document.getElementById('sourceCards');
    const mug3dWrap = document.getElementById('mug3dWrap');
    const mugCaptionEl = document.getElementById('mugCaption');
    const shapeStatusEl = document.getElementById('shapeStatus');
    const profileStatusEl = document.getElementById('profileStatus');
    const tempChartCanvas = document.getElementById('tempChartCanvas');
    const chartLegendEl = document.getElementById('chartLegend');
    const timeSlider = document.getElementById('timeSlider');
    const timeVal = document.getElementById('timeVal');
    const playBtn = document.getElementById('playBtn');
    const polarTemp2hEl = document.getElementById('polarTemp2h');
    const polarMassEl = document.getElementById('polarMass');
    const polarTouchEl = document.getElementById('polarTouch');
    const polarHandleEl = document.getElementById('polarHandle');

    const SOURCE_COLORS = { bootstrap: '#5b9dff' };
    let sourceCardEls = {};

    let meta, X, Y;
    let offsets = {};
    let sourceRanges = [];
    let targetRange = [];
    let viewRange = [];
    let filters = [];
    let filteredIndices = [];
    let histCanvases = [];
    let handleLabels = [];
    let currentValues = [];
    let lastCounts = [];
    let umapPoints = null;
    let hoveredSourceCode = null;
    let currentSeries = null; // last-fetched temperature series for the active candidate
    let playTimer = null;

    const N_BINS = 30;

    async function loadData() {
      const [metaRes, xRes, yRes] = await Promise.all([
        fetch('/data/mug/meta.json'),
        fetch('/data/mug/X.bin'),
        fetch('/data/mug/Y.bin'),
      ]);
      meta = await metaRes.json();
      X = new Float32Array(await xRes.arrayBuffer());
      Y = new Float32Array(await yRes.arrayBuffer());
      currentValues = new Array(meta.y_cols).fill(null);

      let start = 0;
      for (const code of Object.keys(meta.source_legend).map(Number).sort((a, b) => a - b)) {
        const name = meta.source_legend[code];
        const count = meta.source_counts[name];
        offsets[code] = { start, count, name };
        start += count;
      }
      offsets[-1] = { start: 0, count: meta.n, name: 'all sources' };

      sourceEl.innerHTML = '';
      const allOpt = document.createElement('option');
      allOpt.value = -1;
      allOpt.textContent = `all sources (${meta.n.toLocaleString()})`;
      sourceEl.appendChild(allOpt);
      sourceRanges = [];
      sourceCardsEl.innerHTML = '';
      sourceCardEls = {};
      for (const code of Object.keys(meta.source_legend).map(Number).sort((a, b) => a - b)) {
        const { name, count } = offsets[code];
        const opt = document.createElement('option');
        opt.value = code;
        opt.textContent = `${name} (${count.toLocaleString()})`;
        sourceEl.appendChild(opt);
        sourceRanges.push({ code, name, start: offsets[code].start, count });

        const card = document.createElement('div');
        card.className = 'source-card';
        card.style.setProperty('--src-color', SOURCE_COLORS[name] || '#c76bff');
        card.innerHTML = `<span class="dot"></span><span class="name">${name}</span><span class="count"></span>`;
        card.addEventListener('mouseenter', () => { hoveredSourceCode = code; card.classList.add('active'); if (umapPoints) drawUMAP(); });
        card.addEventListener('mouseleave', () => { hoveredSourceCode = null; card.classList.remove('active'); if (umapPoints) drawUMAP(); });
        sourceCardsEl.appendChild(card);
        sourceCardEls[code] = { root: card, countEl: card.querySelector('.count') };
      }

      for (let t = 0; t < meta.y_cols; t++) {
        let mn = Infinity, mx = -Infinity;
        for (let r = 0; r < meta.n; r++) {
          const v = Y[r * meta.y_cols + t];
          if (v < mn) mn = v;
          if (v > mx) mx = v;
        }
        targetRange.push({ min: mn, max: mx });
        viewRange.push({ min: mn, max: mx });
        filters.push({ min: mn, max: mx });
      }

      umapColorByEl.innerHTML = '';
      const sourceOpt = document.createElement('option');
      sourceOpt.value = 'source';
      sourceOpt.textContent = 'source';
      umapColorByEl.appendChild(sourceOpt);
      meta.target_names.forEach((name, t) => {
        const opt = document.createElement('option');
        opt.value = t;
        opt.textContent = name;
        umapColorByEl.appendChild(opt);
      });
      umapColorByEl.value = 'source';

      buildFilterRows();
      subtitleEl.textContent = `${meta.n.toLocaleString()} candidates loaded`;
    }

    function sourceCodeOf(gi) {
      for (const r of sourceRanges) { if (gi >= r.start && gi < r.start + r.count) return r.code; }
      return null;
    }

    function roundSig(v, sig) {
      const a = Math.abs(v);
      if (a !== 0 && (a < 1e-3 || a >= 1e5)) return v.toExponential(Math.max(0, sig - 1));
      return Number(v.toPrecision(sig)).toString();
    }
    const round5 = (v) => roundSig(v, 5);

    function buildFilterRows() {
      filtersEl.innerHTML = '';
      histCanvases = []; handleLabels = [];
      meta.target_names.forEach((name, t) => {
        const row = document.createElement('div');
        row.className = 'card metric-card';
        const info = METRIC_INFO[name];
        const iconHtml = info ? `<span class="info-icon" data-tip="${info.short.replace(/"/g, '&quot;')}">i</span>` : '';
        row.innerHTML = `
          <button class="metric-header" data-t="${t}">
            <span class="chevron">▸</span>
            <span class="metric-name">${name}</span>
            ${iconHtml}
            <span class="metric-value-inline" id="cur-${t}">–</span>
            <span class="spacer"></span>
            <span class="metric-pct" id="pct-${t}"></span>
          </button>
          <div class="metric-body">
            <div class="body-toolbar"><button class="link" id="zoom-reset-${t}">reset zoom</button></div>
            <div class="hist-wrap">
              <span class="handle-label" id="handle-min-${t}"></span>
              <span class="handle-label" id="handle-max-${t}"></span>
            </div>
          </div>`;
        const canvas = document.createElement('canvas');
        canvas.width = 300; canvas.height = 52;
        histCanvases[t] = canvas;
        row.querySelector('.hist-wrap').insertBefore(canvas, row.querySelector('.handle-label'));
        row.querySelector('.metric-header').addEventListener('click', () => row.classList.toggle('expanded'));
        row.querySelector(`#zoom-reset-${t}`).addEventListener('click', () => resetZoom(t));
        filtersEl.appendChild(row);

        const minLabel = document.getElementById(`handle-min-${t}`);
        const maxLabel = document.getElementById(`handle-max-${t}`);
        handleLabels[t] = { min: minLabel, max: maxLabel };
        makeLabelEditable(minLabel, t, 'min');
        makeLabelEditable(maxLabel, t, 'max');
        setupDrag(canvas, t);
      });
      meta.target_names.forEach((_, t) => positionHandles(t));
    }

    function positionHandles(t, liveOverride) {
      const { min, max } = viewRange[t];
      const span = (max - min) || 1;
      const f = liveOverride || filters[t];
      const minFrac = Math.min(1, Math.max(0, (f.min - min) / span));
      const maxFrac = Math.min(1, Math.max(0, (f.max - min) / span));
      const { min: minEl, max: maxEl } = handleLabels[t];
      minEl.style.left = `${minFrac * 100}%`;
      maxEl.style.left = `${maxFrac * 100}%`;
      if (!minEl.querySelector('input')) minEl.textContent = round5(f.min);
      if (!maxEl.querySelector('input')) maxEl.textContent = round5(f.max);
    }

    function resetZoom(t) {
      viewRange[t] = { ...targetRange[t] };
      filters[t] = { ...targetRange[t] };
      positionHandles(t);
      recomputeFiltered();
    }

    function makeLabelEditable(labelEl, t, which) {
      labelEl.addEventListener('click', () => {
        if (labelEl.querySelector('input')) return;
        const current = filters[t][which];
        labelEl.textContent = '';
        const input = document.createElement('input');
        input.type = 'number'; input.step = 'any'; input.value = current;
        labelEl.appendChild(input);
        input.focus(); input.select();
        const commit = () => {
          const v = Number(input.value);
          if (!Number.isNaN(v)) {
            const next = { ...filters[t], [which]: v };
            setFilter(t, next.min, next.max);
          } else { positionHandles(t); }
        };
        input.addEventListener('blur', commit);
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') input.blur();
          if (e.key === 'Escape') positionHandles(t);
        });
      });
    }

    function setFilter(t, min, max) {
      filters[t] = { min: Math.min(min, max), max: Math.max(min, max) };
      positionHandles(t);
      recomputeFiltered();
    }

    function setupDrag(canvas, t) {
      let dragging = null;
      const HIT_PX = 10;
      function fracFromEvent(e) {
        const rect = canvas.getBoundingClientRect();
        return Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      }
      function fracToValue(frac) {
        const { min, max } = viewRange[t];
        return min + frac * (max - min);
      }
      function fracOf(which) {
        const { min, max } = viewRange[t];
        const span = (max - min) || 1;
        return (filters[t][which] - min) / span;
      }
      function onMove(e) {
        const frac = fracFromEvent(e);
        const value = fracToValue(frac);
        const live = { ...filters[t], [dragging]: value };
        if (live.min > live.max) live[dragging] = filters[t][dragging === 'min' ? 'max' : 'min'];
        positionHandles(t, live);
        drawHistogram(t, lastCounts[t], { liveFilter: live });
        const label = handleLabels[t][dragging];
        if (!label.querySelector('input')) label.textContent = round5(value);
      }
      function onUp(e) {
        window.removeEventListener('mousemove', onMove);
        window.removeEventListener('mouseup', onUp);
        const frac = fracFromEvent(e);
        const value = fracToValue(frac);
        const next = dragging === 'min' ? { min: value, max: filters[t].max } : { min: filters[t].min, max: value };
        filters[t] = { min: Math.min(next.min, next.max), max: Math.max(next.min, next.max) };
        viewRange[t] = { ...filters[t] };
        positionHandles(t);
        recomputeFiltered();
        dragging = null;
      }
      canvas.addEventListener('mousedown', (e) => {
        const rect = canvas.getBoundingClientRect();
        const clickPx = e.clientX - rect.left;
        const minPx = fracOf('min') * rect.width;
        const maxPx = fracOf('max') * rect.width;
        if (Math.abs(clickPx - minPx) <= HIT_PX && Math.abs(clickPx - minPx) <= Math.abs(clickPx - maxPx)) dragging = 'min';
        else if (Math.abs(clickPx - maxPx) <= HIT_PX) dragging = 'max';
        else dragging = Math.abs(clickPx - minPx) <= Math.abs(clickPx - maxPx) ? 'min' : 'max';
        window.addEventListener('mousemove', onMove);
        window.addEventListener('mouseup', onUp);
      });
    }

    document.getElementById('resetAllBtn').addEventListener('click', () => {
      for (let t = 0; t < meta.y_cols; t++) {
        filters[t] = { ...targetRange[t] };
        viewRange[t] = { ...targetRange[t] };
        positionHandles(t);
      }
      recomputeFiltered();
    });

    function sourceScope() { return offsets[Number(sourceEl.value)]; }

    function recomputeFiltered() {
      const { start, count } = sourceScope();
      const yCols = meta.y_cols;
      filteredIndices = [];
      const hist = Array.from({ length: yCols }, () => new Array(N_BINS).fill(0));
      for (let i = 0; i < count; i++) {
        const gi = start + i;
        const yBase = gi * yCols;
        let pass = true;
        for (let t = 0; t < yCols; t++) {
          const v = Y[yBase + t];
          if (v < filters[t].min || v > filters[t].max) pass = false;
          const { min: vmin, max: vmax } = viewRange[t];
          if (v < vmin || v > vmax) continue;
          const bin = Math.min(N_BINS - 1, Math.max(0, Math.floor(((v - vmin) / (vmax - vmin || 1)) * N_BINS)));
          hist[t][bin]++;
        }
        if (pass) filteredIndices.push(gi);
      }
      lastCounts = hist;
      for (let t = 0; t < yCols; t++) drawHistogram(t, hist[t]);
      const frac = count ? filteredIndices.length / count : 0;
      matchLabelEl.innerHTML = `<b>${filteredIndices.length.toLocaleString()}</b> of ${count.toLocaleString()} match`;
      matchFillEl.style.width = `${(frac * 100).toFixed(1)}%`;
      indexEl.max = Math.max(0, filteredIndices.length - 1);
      if (Number(indexEl.value) >= filteredIndices.length) indexEl.value = 0;
      renderCandidate();
    }

    function drawHistogram(t, counts, opts) {
      const canvas = histCanvases[t];
      const ctx = canvas.getContext('2d');
      const w = canvas.width, h = canvas.height;
      ctx.clearRect(0, 0, w, h);
      const maxCount = Math.max(1, ...counts);
      const barW = w / N_BINS;
      const { min, max } = viewRange[t];
      const f = (opts && opts.liveFilter) || filters[t];
      for (let b = 0; b < N_BINS; b++) {
        const binLo = min + (b / N_BINS) * (max - min);
        const binHi = min + ((b + 1) / N_BINS) * (max - min);
        const inRange = binHi >= f.min && binLo <= f.max;
        const barH = Math.max(1, (counts[b] / maxCount) * (h - 4));
        ctx.fillStyle = inRange ? '#5b9dff' : '#33333a';
        ctx.fillRect(b * barW, h - barH, Math.max(1, barW - 1), barH);
      }
      ['min', 'max'].forEach((which) => {
        const span = (max - min) || 1;
        const x = ((f[which] - min) / span) * w;
        ctx.fillStyle = '#ffb454';
        ctx.fillRect(x - 1, 0, 2, h);
        ctx.beginPath(); ctx.moveTo(x - 5, 0); ctx.lineTo(x + 5, 0); ctx.lineTo(x, 7); ctx.closePath(); ctx.fill();
      });
      const cv = currentValues[t];
      if (cv !== null && cv !== undefined && cv >= min && cv <= max) {
        const x = ((cv - min) / (max - min || 1)) * w;
        ctx.strokeStyle = 'rgba(255,255,255,0.9)'; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
        ctx.fillStyle = '#ffffff';
        ctx.beginPath(); ctx.arc(x, h - 2, 3, 0, 2 * Math.PI); ctx.fill();
      }
    }

    // --- Mug-specific: 3D shape of revolution (frustum-based body per
    // thermal_mug_spike.py's simulate_v3, EXPERIMENT_LOG §50) + a liquid
    // core + an optional lid disc + a handle, all colored by real surface
    // temperature at the current point in the time slider -- plus a
    // temperature-vs-time chart driven by the same series data.
    //
    // Body geometry uses THREE.LatheGeometry over exactly the 3 profile
    // points the physics model itself uses (r_base at z=0, r_mid at
    // z=H/2, r_rim at z=H) -- 2 straight-line segments, matching the
    // model's own 2-band frustum structure exactly rather than a smoothed
    // curve that would imply more shape detail than is actually simulated.
    //
    // §52 user feedback: a TORAX-style wedge cutaway just read as "a bite
    // taken out of the mug," not a deliberate cross-section -- a tokamak's
    // nested-shell cutaway is a real, recognized convention; a mug isn't
    // usually understood that way. Fixed with a FULL 360-degree revolve
    // (no notch) plus a solid base cap, so the shape reads unambiguously
    // as a mug -- the liquid inside is instead revealed the way a real
    // mug actually shows it: through the genuinely OPEN top (the drinking
    // opening), not an artificial wall cutaway. A thin rim ring marks the
    // opening explicitly, so "which end is the top" doesn't rely on
    // guessing from silhouette alone.
    const LATHE_SEGMENTS = 48;

    const m3dScene = new THREE.Scene();
    m3dScene.background = new THREE.Color(0x0c0c0e);
    const m3dCamera = new THREE.PerspectiveCamera(50, 1, 0.001, 10);
    const m3dRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
    mug3dWrap.appendChild(m3dRenderer.domElement);
    const m3dControls = new OrbitControls(m3dCamera, m3dRenderer.domElement);
    m3dControls.enableDamping = true;
    m3dScene.add(new THREE.AmbientLight(0xffffff, 1.0));
    m3dScene.add(new THREE.DirectionalLight(0xffffff, 0.4));

    let m3dGroup = new THREE.Group();
    m3dScene.add(m3dGroup);
    let m3dParts = {}; // { bodyMesh, liquidMesh, lidMesh, handleMesh, bottomMesh, rimRing }
    let m3dInitialized = false;
    let lastGeom = null;

    // Cold-blue -> warm-yellow -> hot-red -- deliberately NOT the
    // plasma/viridis palette the stellarator/airfoil/TORAX viewers use.
    // §52 user feedback: plasma reads as a scientific/"alien" heatmap, not
    // "this mug is hot" -- a mug is an everyday object, so it gets the
    // everyday cold/hot color convention instead. Same 3 stops already
    // used for this page's own UMAP legend gradient, kept consistent.
    const THERMAL_STOPS = [[58, 111, 216], [216, 201, 58], [216, 72, 58]];
    function colorForTemp(t) {
      const frac = Math.max(0, Math.min(1, (t - COLOR_MIN_C) / (COLOR_MAX_C - COLOR_MIN_C)));
      const scaled = frac * (THERMAL_STOPS.length - 1);
      const i = Math.min(THERMAL_STOPS.length - 2, Math.floor(scaled));
      const tt = scaled - i;
      const a = THERMAL_STOPS[i], b = THERMAL_STOPS[i + 1];
      return new THREE.Color(
        (a[0] + (b[0] - a[0]) * tt) / 255,
        (a[1] + (b[1] - a[1]) * tt) / 255,
        (a[2] + (b[2] - a[2]) * tt) / 255,
      );
    }

    function buildBodyGeometry(rBase, rMid, rRim, height) {
      const points = [
        new THREE.Vector2(Math.max(0.001, rBase), 0),
        new THREE.Vector2(Math.max(0.001, rMid), height / 2),
        new THREE.Vector2(Math.max(0.001, rRim), height),
      ];
      const geometry = new THREE.LatheGeometry(points, LATHE_SEGMENTS, 0, Math.PI * 2);
      // per-vertex color placeholder (grayscale until the first physics
      // response arrives) -- height-based gradient applied properly in
      // applyBodyColors() below once real surface temps are known.
      const count = geometry.attributes.position.count;
      geometry.setAttribute('color', new THREE.BufferAttribute(new Float32Array(count * 3).fill(0.4), 3));
      return geometry;
    }

    function applyBodyColors(geometry, height, colorBase, colorRim) {
      const pos = geometry.attributes.position;
      const colorAttr = geometry.attributes.color;
      for (let i = 0; i < pos.count; i++) {
        const y = pos.getY(i);
        const frac = Math.max(0, Math.min(1, y / height));
        const c = colorBase.clone().lerp(colorRim, frac);
        colorAttr.setXYZ(i, c.r, c.g, c.b);
      }
      colorAttr.needsUpdate = true;
    }

    function buildMugShape(p) {
      m3dScene.remove(m3dGroup);
      m3dGroup = new THREE.Group();
      m3dParts = {};

      const rBase = p.r_base_mm / 1000, rMid = p.r_mid_mm / 1000, rRim = p.r_rim_mm / 1000;
      const height = 0.10; // fixed HEIGHT constant, thermal_mug_spike.py

      // Opaque, solid -- a real mug isn't see-through; the liquid is
      // revealed through the genuinely open top instead (see below), not
      // by making the wall translucent.
      const bodyGeom = buildBodyGeometry(rBase, rMid, rRim, height);
      const bodyMat = new THREE.MeshBasicMaterial({ vertexColors: true, side: THREE.DoubleSide });
      const bodyMesh = new THREE.Mesh(bodyGeom, bodyMat);
      m3dGroup.add(bodyMesh);
      m3dParts.bodyMesh = bodyMesh;
      m3dParts.height = height;

      // Solid base cap -- closes off the bottom so the shape doesn't read
      // as a hollow tube open at both ends. This is what makes "top" vs.
      // "bottom" unambiguous: the base is solid, the rim (below) is open.
      const bottomGeom = new THREE.CircleGeometry(rBase, LATHE_SEGMENTS);
      const bottomMat = new THREE.MeshBasicMaterial({ color: 0x888888, side: THREE.DoubleSide });
      const bottomMesh = new THREE.Mesh(bottomGeom, bottomMat);
      bottomMesh.rotation.x = Math.PI / 2;
      bottomMesh.position.y = -0.0005;
      m3dGroup.add(bottomMesh);
      m3dParts.bottomMesh = bottomMesh;

      // A thin light ring right at the rim's outer edge -- marks the
      // opening explicitly rather than relying on silhouette alone.
      const rimRingGeom = new THREE.TorusGeometry(rRim, Math.max(0.0006, rRim * 0.012), 8, LATHE_SEGMENTS);
      const rimRingMat = new THREE.MeshBasicMaterial({ color: 0xe8e8ec });
      const rimRing = new THREE.Mesh(rimRingGeom, rimRingMat);
      rimRing.rotation.x = Math.PI / 2;
      rimRing.position.y = height;
      m3dGroup.add(rimRing);
      m3dParts.rimRing = rimRing;

      // Liquid core -- a simple visual approximation (physics only tracks
      // total wall+gap thickness via a thin-wall approximation, not an
      // exact inner-vs-outer radius split, so this can't be more precise
      // than the model itself). ~78% of the outer radius, filled to ~92%
      // of the height (a small headspace at the rim) -- visible by
      // looking down through the mug's own open top, the same way you'd
      // see into a real mug, no artificial cutaway needed.
      const avgR = (rBase + rMid + rRim) / 3;
      const liquidGeom = new THREE.CylinderGeometry(avgR * 0.8, avgR * 0.75, height * 0.92, 32);
      const liquidMat = new THREE.MeshBasicMaterial({ color: 0x888888 });
      const liquidMesh = new THREE.Mesh(liquidGeom, liquidMat);
      liquidMesh.position.y = height * 0.92 / 2;
      m3dGroup.add(liquidMesh);
      m3dParts.liquidMesh = liquidMesh;

      // Lid -- a disc at z=height, sized so its AREA is proportional to
      // lid_coverage_frac of the rim opening (a simplification: doesn't
      // represent WHICH part of the opening is covered, just how much).
      const lidCoverage = Math.max(0, Math.min(1, p.lid_coverage_frac));
      if (lidCoverage > 0.01) {
        const lidR = rRim * Math.sqrt(lidCoverage);
        const lidGeom = new THREE.CircleGeometry(lidR, 32);
        const lidMat = new THREE.MeshBasicMaterial({ color: 0x888888, side: THREE.DoubleSide });
        const lidMesh = new THREE.Mesh(lidGeom, lidMat);
        lidMesh.rotation.x = -Math.PI / 2;
        lidMesh.position.y = height + 0.0005;
        m3dGroup.add(lidMesh);
        m3dParts.lidMesh = lidMesh;
      }

      // Handle -- a simple horizontal cylinder attached at mid-height,
      // pointing outward from the body. Colored uniformly by the handle
      // TIP temperature (a simplification -- the physics does resolve a
      // real gradient along its length, but a single color reads more
      // clearly at this small scale than a gradient would).
      const handleLen = p.handle_length_mm / 1000, handleDia = p.handle_diameter_mm / 1000;
      const handleGeom = new THREE.CapsuleGeometry(handleDia / 2, handleLen, 4, 8);
      const handleMat = new THREE.MeshBasicMaterial({ color: 0x888888 });
      const handleMesh = new THREE.Mesh(handleGeom, handleMat);
      handleMesh.rotation.z = Math.PI / 2;
      // attach on the +X side, sticking straight outward from the body
      handleMesh.position.set(rMid + handleLen / 2 + handleDia / 2, height / 2, 0);
      m3dGroup.add(handleMesh);
      m3dParts.handleMesh = handleMesh;

      m3dScene.add(m3dGroup);
      lastGeom = { rBase, rMid, rRim, height };

      if (!m3dInitialized) {
        // Elevated enough to look down INTO the open top by default (so the
        // liquid + rim ring read immediately, without needing to orbit) --
        // §52 feedback wanted the top/bottom/opening obvious at a glance.
        const scale = Math.max(rRim, height);
        m3dCamera.position.set(scale * 2.3, scale * 3.0, scale * 2.3);
        m3dControls.target.set(0, height * 0.6, 0);
        m3dInitialized = true;
      }
    }

    // Colors every part by the real surface temps at the current time-slider
    // frame -- called on every candidate change AND every timestep change,
    // so scrubbing/playing the slider visibly reheats/cools the shape in
    // sync with the 2D chart, same convention as the TORAX viewer.
    function updateMugColors(series, frameIdx) {
      if (!series || !lastGeom) return;
      const tRim = series.T_rim_outer[frameIdx];
      const tBase = series.T_base_outer[frameIdx];
      const tLid = series.T_lid_outer[frameIdx];
      const tLiq = series.T_liq[frameIdx];
      const tHandle = series.T_handle_tip[frameIdx];

      applyBodyColors(m3dParts.bodyMesh.geometry, lastGeom.height, colorForTemp(tBase), colorForTemp(tRim));
      m3dParts.liquidMesh.material.color.copy(colorForTemp(tLiq));
      m3dParts.bottomMesh.material.color.copy(colorForTemp(tBase));
      m3dParts.rimRing.material.color.copy(colorForTemp(tRim));
      if (m3dParts.lidMesh && tLid !== null && tLid !== undefined) {
        m3dParts.lidMesh.material.color.copy(colorForTemp(tLid));
      }
      m3dParts.handleMesh.material.color.copy(colorForTemp(tHandle));
    }

    function resizeMug3d() {
      const w = mug3dWrap.clientWidth, h = mug3dWrap.clientHeight;
      if (!w || !h) return;
      m3dRenderer.setSize(w, h, false);
      m3dRenderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      m3dCamera.aspect = w / h;
      m3dCamera.updateProjectionMatrix();
    }
    (function m3dAnimate() {
      requestAnimationFrame(m3dAnimate);
      m3dControls.update();
      m3dRenderer.render(m3dScene, m3dCamera);
    })();
    window.addEventListener('resize', resizeMug3d);
    resizeMug3d();

    const CHART_SERIES = [
      { key: 'T_liq', label: 'liquid', color: '#5b9dff' },
      { key: 'T_rim_outer', label: 'rim (outer)', color: '#ffb454' },
      { key: 'T_base_outer', label: 'base (outer)', color: '#5bd88a' },
      { key: 'T_lid_outer', label: 'lid (outer)', color: '#c76bff' },
      { key: 'T_handle_tip', label: 'handle tip', color: '#ff6b6b' },
    ];

    function drawTempChart(series, frameIdx) {
      const canvas = tempChartCanvas;
      const ctx = canvas.getContext('2d');
      const w = canvas.width = canvas.clientWidth * devicePixelRatio;
      const h = canvas.height = canvas.clientHeight * devicePixelRatio;
      ctx.clearRect(0, 0, w, h);
      if (!series) return;
      const pad = 10 * devicePixelRatio;
      const tMax = series.t_s[series.t_s.length - 1] || 1;
      const allVals = CHART_SERIES.flatMap((s) => (series[s.key] || []).filter((v) => v !== null && v !== undefined));
      const minV = Math.min(15, ...allVals), maxV = Math.max(95, ...allVals);
      const px = (t) => pad + (t / tMax) * (w - 2 * pad);
      const py = (v) => h - pad - ((v - minV) / ((maxV - minV) || 1)) * (h - 2 * pad);

      CHART_SERIES.forEach(({ key, color }) => {
        const values = series[key];
        if (!values) return;
        ctx.strokeStyle = color; ctx.lineWidth = 2 * devicePixelRatio;
        ctx.beginPath();
        let started = false;
        values.forEach((v, i) => {
          if (v === null || v === undefined) return;
          const fn = started ? 'lineTo' : 'moveTo';
          ctx[fn](px(series.t_s[i]), py(v));
          started = true;
        });
        ctx.stroke();
      });

      // current-time marker
      const curT = series.t_s[frameIdx];
      if (curT !== undefined) {
        ctx.strokeStyle = 'rgba(255,255,255,0.8)'; ctx.lineWidth = 1.5 * devicePixelRatio;
        ctx.beginPath(); ctx.moveTo(px(curT), pad); ctx.lineTo(px(curT), h - pad); ctx.stroke();
      }
    }

    function buildChartLegend() {
      chartLegendEl.innerHTML = CHART_SERIES.map((s) =>
        `<span class="swatch"><span class="dot" style="background:${s.color}"></span>${s.label}</span>`).join('');
    }
    buildChartLegend();

    function renderSeriesAtFrame(k) {
      if (!currentSeries) return;
      const t = currentSeries.t_s[k];
      timeVal.textContent = t < 60 ? `t=${t.toFixed(0)}s` : `t=${(t / 60).toFixed(1)}min`;
      drawTempChart(currentSeries, k);
      updateMugColors(currentSeries, k);
    }

    timeSlider.addEventListener('input', () => renderSeriesAtFrame(Number(timeSlider.value)));
    playBtn.addEventListener('click', () => {
      if (playTimer) {
        clearInterval(playTimer); playTimer = null; playBtn.textContent = '▶';
        return;
      }
      playBtn.textContent = '⏸';
      playTimer = setInterval(() => {
        if (!currentSeries) return;
        let k = (Number(timeSlider.value) + 1) % currentSeries.t_s.length;
        timeSlider.value = k;
        renderSeriesAtFrame(k);
      }, 120);
    });

    let physicsAbort = null;
    async function updatePhysics(gi) {
      const rowStart = gi * meta.x_cols;
      const params = PARAM_NAMES.map((_, i) => X[rowStart + i]);
      const p = {};
      PARAM_NAMES.forEach((name, i) => { p[name] = params[i]; });

      buildMugShape(p);
      resizeMug3d();
      mugCaptionEl.textContent = `r_base=${p.r_base_mm.toFixed(1)}mm  r_mid=${p.r_mid_mm.toFixed(1)}mm  r_rim=${p.r_rim_mm.toFixed(1)}mm  ·  lid coverage=${(p.lid_coverage_frac * 100).toFixed(0)}%  ·  rim ring marks the open top; base is solid`;
      shapeStatusEl.textContent = '';

      if (physicsAbort) physicsAbort.abort();
      physicsAbort = new AbortController();
      profileStatusEl.textContent = 'loading…';
      try {
        const res = await fetch(`${PHYSICS_URL}/physics`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ params }),
          signal: physicsAbort.signal,
        });
        if (!res.ok) throw new Error(`physics ${res.status}`);
        const bundle = await res.json();
        profileStatusEl.textContent = bundle.cached ? 'cached' : 'ready';
        currentSeries = bundle.series;
        timeSlider.max = currentSeries.t_s.length - 1;
        timeSlider.value = currentSeries.t_s.length - 1;
        renderSeriesAtFrame(currentSeries.t_s.length - 1);
        polarTemp2hEl.textContent = round5(bundle.targets.temp_at_2h_C);
        polarMassEl.textContent = round5(bundle.targets.mass_kg);
        polarTouchEl.textContent = round5(bundle.targets.touch_temp_60s_C);
        polarHandleEl.textContent = round5(bundle.targets.handle_temp_60s_C);
      } catch (e) {
        if (e.name !== 'AbortError') {
          profileStatusEl.textContent = `error: ${e.message}`;
          currentSeries = null;
          polarTemp2hEl.textContent = polarMassEl.textContent = polarTouchEl.textContent = polarHandleEl.textContent = 'n/c';
        }
      }
    }

    function currentGi() {
      if (!filteredIndices.length) return null;
      const pos = Math.max(0, Math.min(filteredIndices.length - 1, Number(indexEl.value) || 0));
      return filteredIndices[pos];
    }

    function renderCandidate() {
      const gi = currentGi();
      if (gi === null) return;
      const yBase = gi * meta.y_cols;
      for (let t = 0; t < meta.y_cols; t++) {
        const v = Y[yBase + t];
        currentValues[t] = v;
        document.getElementById(`cur-${t}`).textContent = round5(v);
        const { min, max } = targetRange[t];
        const pct = max > min ? ((v - min) / (max - min)) * 100 : 50;
        document.getElementById(`pct-${t}`).textContent = `${pct.toFixed(0)}%ile`;
      }
      meta.target_names.forEach((_, t) => positionHandles(t));
      for (let t = 0; t < meta.y_cols; t++) drawHistogram(t, lastCounts[t] || new Array(N_BINS).fill(0));

      const rowStart = gi * meta.x_cols;
      globalRowEl.textContent = gi.toLocaleString();
      rRimValEl.textContent = X[rowStart + PARAM_NAMES.indexOf('r_rim_mm')].toFixed(1);
      lidValEl.textContent = (X[rowStart + PARAM_NAMES.indexOf('lid_coverage_frac')] * 100).toFixed(0);
      massValEl.textContent = Y[yBase + meta.target_names.indexOf('mass_kg')].toFixed(3);

      updatePhysics(gi);
    }

    sourceEl.addEventListener('change', () => { indexEl.value = 0; recomputeFiltered(); });
    document.getElementById('prevBtn').addEventListener('click', () => { indexEl.value = Math.max(0, Number(indexEl.value) - 1); renderCandidate(); });
    document.getElementById('nextBtn').addEventListener('click', () => { indexEl.value = Math.min(filteredIndices.length - 1, Number(indexEl.value) + 1); renderCandidate(); });
    document.getElementById('randomBtn').addEventListener('click', () => { indexEl.value = Math.floor(Math.random() * filteredIndices.length); renderCandidate(); });
    indexEl.addEventListener('input', renderCandidate);

    // --- UMAP ---
    async function computeUMAP() {
      const { start, count } = sourceScope();
      const pool = filteredIndices.length ? filteredIndices : Array.from({ length: count }, (_, i) => start + i);
      const n = Math.min(800, pool.length);
      if (n < 5) { umapStatusEl.textContent = 'not enough points'; return; }
      const rng = () => Math.random();
      const sampled = [];
      const seen = new Set();
      while (sampled.length < n) {
        const idx = pool[Math.floor(rng() * pool.length)];
        if (!seen.has(idx)) { seen.add(idx); sampled.push(idx); }
      }
      const yCols = meta.y_cols;
      const means = new Array(yCols).fill(0), stds = new Array(yCols).fill(0);
      for (const gi of sampled) for (let t = 0; t < yCols; t++) means[t] += Y[gi * yCols + t] / n;
      for (const gi of sampled) for (let t = 0; t < yCols; t++) stds[t] += (Y[gi * yCols + t] - means[t]) ** 2 / n;
      for (let t = 0; t < yCols; t++) stds[t] = Math.sqrt(stds[t]) || 1;

      const data = sampled.map((gi) => Array.from({ length: yCols }, (_, t) => (Y[gi * yCols + t] - means[t]) / stds[t]));
      umapStatusEl.textContent = `computing UMAP over ${n} points…`;
      await new Promise((r) => setTimeout(r, 10));
      const umap = new UMAP({ nNeighbors: Math.min(15, n - 1), minDist: 0.3, nComponents: 2 });
      const embedding = umap.fit(data);
      umapPoints = { globalIndices: sampled, positions: embedding };
      umapStatusEl.textContent = `${n} points`;
      drawUMAP();
    }

    function drawUMAP() {
      if (!umapPoints) return;
      const ctx = umapCanvas.getContext('2d');
      const w = umapCanvas.width = umapCanvasWrap.clientWidth * devicePixelRatio;
      const h = umapCanvas.height = umapCanvasWrap.clientHeight * devicePixelRatio;
      ctx.clearRect(0, 0, w, h);
      const xs = umapPoints.positions.map((p) => p[0]);
      const ys = umapPoints.positions.map((p) => p[1]);
      const minX = Math.min(...xs), maxX = Math.max(...xs);
      const minY = Math.min(...ys), maxY = Math.max(...ys);
      const pad = 14 * devicePixelRatio;
      const sx = (v) => pad + ((v - minX) / ((maxX - minX) || 1)) * (w - 2 * pad);
      const sy = (v) => pad + ((v - minY) / ((maxY - minY) || 1)) * (h - 2 * pad);

      const colorBy = umapColorByEl.value;
      let cmin, cmax;
      if (colorBy !== 'source') {
        const t = Number(colorBy);
        const vals = umapPoints.globalIndices.map((gi) => Y[gi * meta.y_cols + t]);
        cmin = Math.min(...vals); cmax = Math.max(...vals);
        umapLegendEl.style.display = 'flex';
        umapLegendMinEl.textContent = round5(cmin);
        umapLegendMaxEl.textContent = round5(cmax);
      } else {
        umapLegendEl.style.display = 'none';
      }

      umapPoints.globalIndices.forEach((gi, i) => {
        const code = sourceCodeOf(gi);
        let color;
        if (colorBy === 'source') color = SOURCE_COLORS[offsets[code] ? offsets[code].name : ''] || '#c76bff';
        else {
          const t = Number(colorBy);
          const v = Y[gi * meta.y_cols + t];
          const frac = cmax > cmin ? (v - cmin) / (cmax - cmin) : 0.5;
          color = colormapHex('viridis', frac);
        }
        const dim = hoveredSourceCode !== null && code !== hoveredSourceCode;
        ctx.globalAlpha = dim ? 0.15 : 0.75;
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.arc(sx(xs[i]), sy(ys[i]), 2.5 * devicePixelRatio, 0, 2 * Math.PI);
        ctx.fill();
      });
      ctx.globalAlpha = 1;
    }

    umapCanvas.addEventListener('click', (e) => {
      if (!umapPoints) return;
      const rect = umapCanvas.getBoundingClientRect();
      const mx = (e.clientX - rect.left) * devicePixelRatio;
      const my = (e.clientY - rect.top) * devicePixelRatio;
      const xs = umapPoints.positions.map((p) => p[0]);
      const ys = umapPoints.positions.map((p) => p[1]);
      const minX = Math.min(...xs), maxX = Math.max(...xs);
      const minY = Math.min(...ys), maxY = Math.max(...ys);
      const w = umapCanvas.width, h = umapCanvas.height;
      const pad = 14 * devicePixelRatio;
      const sx = (v) => pad + ((v - minX) / ((maxX - minX) || 1)) * (w - 2 * pad);
      const sy = (v) => pad + ((v - minY) / ((maxY - minY) || 1)) * (h - 2 * pad);
      let best = -1, bestD = Infinity;
      umapPoints.globalIndices.forEach((gi, i) => {
        const d = (sx(xs[i]) - mx) ** 2 + (sy(ys[i]) - my) ** 2;
        if (d < bestD) { bestD = d; best = gi; }
      });
      if (best < 0) return;
      const pos = filteredIndices.indexOf(best);
      if (pos >= 0) { indexEl.value = pos; renderCandidate(); }
    });

    document.getElementById('umapRecomputeBtn').addEventListener('click', computeUMAP);
    umapColorByEl.addEventListener('change', () => { if (umapPoints) drawUMAP(); });
    window.addEventListener('resize', () => { if (umapPoints) drawUMAP(); if (currentSeries) renderSeriesAtFrame(Number(timeSlider.value)); });

    (async () => {
      await loadData();
      recomputeFiltered();
      await computeUMAP();
    })();
  </script>
</body>
</html>
