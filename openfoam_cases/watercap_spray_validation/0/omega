/*--------------------------------*- C++ -*----------------------------------*\
  OpenFOAM-10 | watercap spray-condenser validation case
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 11.3;

boundaryField
{
    inlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.021;     // 0.07 D
        value           uniform 11.3;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 11.3;
        value           uniform 11.3;
    }
    walls
    {
        type            omegaWallFunction;
        value           uniform 11.3;
    }
}
