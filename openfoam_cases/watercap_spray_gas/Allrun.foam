#!/bin/bash
# Runs inside an OpenFOAM-10 environment, in a case generated by gen_case.py.
# Steady (simpleFoam) or transient (pimpleFoam), serial or parallel (NP from case_meta / env).
cd "${0%/*}" || exit 1
. $WM_PROJECT_DIR/bin/tools/RunFunctions
NP=${NP:-1}
APP=$(foamDictionary -entry application -value system/controlDict)
[ -f log.blockMesh ] || { runApplication blockMesh && runApplication checkMesh; }
if [ "$NP" -gt 1 ]; then
    [ -d processor0 ] || runApplication decomposePar -force
    runParallel -a $APP
    runApplication -a reconstructPar -latestTime
else
    runApplication -a $APP
fi
runApplication -a -s C postProcess -func writeCellCentres -latestTime
runApplication -a -s V postProcess -func writeCellVolumes -latestTime
