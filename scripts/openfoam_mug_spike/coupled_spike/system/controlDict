FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

libs            ("libliquidCoupling.so");

application     chtMultiRegionFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         7200;
deltaT          0.5;
writeControl    adjustableRunTime;
writeInterval   60;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
adjustTimeStep  no;
runTimeModifiable true;
